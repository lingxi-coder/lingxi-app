[submodule "docs/superpowers/references/OpenMinis"]
	path = docs/superpowers/references/OpenMinis
	url = https://github.com/OpenMinis/OpenMinis.git
	# OpenMinis is a read-only reference checkout whose nested dependencies can
	# remain locally modified after setup. Ignore its working-tree dirtiness while
	# still reporting a change when the recorded submodule commit itself moves.
	ignore = dirty
