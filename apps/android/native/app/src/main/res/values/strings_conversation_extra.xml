    <string name="chat_question_tap_to_answer">选择一个答案</string>
    <string name="chat_question_previous">上一题</string>
    <string name="chat_question_next">下一题</string>
    <string name="chat_question_other_placeholder">其他</string>
    <string name="chat_question_submit">提交</string>
    <!-- New: background task transition notices. -->
    <string name="chat_task_status_pending">后台任务 %1$s 已排队</string>
    <string name="chat_task_status_running">后台任务 %1$s 运行中</string>
    <string name="chat_task_status_paused">后台任务 %1$s 已暂停</string>
    <string name="chat_task_status_completed">后台任务 %1$s 已完成</string>
