<?xml version="1.0" encoding="utf-8"?>
<!--
  Conversation copy kept outside the generated strings.xml (the AskUserQuestion
  card and background-task status notices). Keys must stay unique against
  values/strings.xml — the resource merger fails on duplicates, which is the
  tripwire that tells us the cross-platform localization sync learned one of
  these keys.
-->
