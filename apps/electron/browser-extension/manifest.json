{
  "manifest_version": 3,
  "name": "LingXi Browser",
  "version": "1.0.0",
  "description": "Connect Chrome to the permission controls in LingXi Desktop.",
  "minimum_chrome_version": "125",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "debugger",
    "tabs",
    "tabGroups",
    "history",
    "downloads",
    "alarms"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Reconnect LingXi Browser"
  }
}
