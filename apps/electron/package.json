{
  "name": "lingxi-code-desktop",
  "version": "0.1.0",
  "description": "LingXi Code — desktop application (Electron + Vite + React + TypeScript)",
  "main": "out/main/index.js",
  "author": "axielix",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/product-namespace.mjs",
    "dev": "electron-vite dev",
    "prebuild": "node scripts/product-namespace.mjs",
    "build": "electron-vite build",
    "postbuild": "node scripts/product-namespace.mjs --stage-build",
    "preview": "electron-vite preview",
    "remote:tunnel:config": "node scripts/local-app-remote-tunnel.mjs",
    "pretest": "node scripts/product-namespace.mjs",
    "test": "node --import ../../packages/bridge-client/node_modules/tsx/dist/loader.mjs --test --test-concurrency=1 test/*.test.ts test/*.test.mjs",
    "sync:local-app-agui": "node scripts/sync-local-app-agui.mjs",
    "sync:local-app-webmcp": "node scripts/sync-local-app-webmcp.mjs",
    "typecheck:local-app-agui": "tsc --noEmit --strict --skipLibCheck false --target ES2022 --module ESNext --moduleResolution Bundler --types node scripts/check-local-app-agui-types.ts",
    "package:mac": "node scripts/package-mac.mjs",
    "package:mac:flare": "bash scripts/package-macos-flare.sh",
    "package:desktop": "node scripts/package-desktop.mjs",
    "verify:desktop-package": "node scripts/verify-desktop-package.mjs",
    "verify:desktop-sidecar": "node scripts/packaged-sidecar-smoke.mjs",
    "verify:package:static": "node scripts/verify-package.mjs",
    "verify:package:smoke": "node scripts/packaged-app-smoke.mjs",
    "verify:package": "npm run verify:package:static && npm run verify:package:smoke",
    "pretypecheck:node": "node scripts/product-namespace.mjs",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web"
  },
  "dependencies": {
    "@dnd-kit/dom": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@lingxi/bridge-client": "file:../../packages/bridge-client",
    "@lingxi/local-app-agui": "file:vendor/local-app-agui",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.223.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "firebase": "13.0.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "43.1.1",
    "electron-vite": "^5.0.0",
    "highlight.js": "^11.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resedit": "2.0.3",
    "typescript": "^5.7.3",
    "vite": "^7.3.6"
  }
}
