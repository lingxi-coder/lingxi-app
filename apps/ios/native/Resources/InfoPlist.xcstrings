{
  "sourceLanguage": "zh-Hans",
  "version": "1.0",
  "strings": {
    "CFBundleDisplayName": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "灵犀"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "靈犀"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LingXi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "LingXi"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "LingXi"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "灵犀使用相机拍摄照片供模型分析。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "靈犀使用相機拍攝照片供模型分析。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LingXi uses the camera to take photos for model analysis."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "灵犀はモデルによる解析のため、カメラで写真を撮影します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "灵犀가 모델 분석을 위해 카메라로 사진을 촬영합니다."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "灵犀使用麦克风进行语音心流输入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "靈犀使用麥克風進行語音心流輸入。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LingXi uses the microphone for voice input in Flow Mode."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "灵犀は音声心流（フローモード）入力のためにマイクを使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "灵犀가 음성 심리스 입력(Flow Mode)을 위해 마이크를 사용합니다."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "灵犀访问相册以选择图片供模型分析。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "靈犀存取相簿以選擇圖片供模型分析。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LingXi accesses your photo library to select images for model analysis."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "灵犀はモデルによる解析のため、写真ライブラリから画像を選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "灵犀가 모델 분석에 사용할 이미지를 선택하기 위해 사진 보관함에 접근합니다."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "灵犀使用语音识别将你的语音转写为文本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "靈犀使用語音識別將你的語音轉寫為文字。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LingXi uses speech recognition to transcribe your voice into text."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "灵犀は音声認識を使用して、あなたの発話をテキストに変換します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "灵犀가 음성 인식을 사용해 사용자의 말을 텍스트로 변환합니다."
          }
        }
      }
    }
  }
}
