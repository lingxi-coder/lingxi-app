        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 이름의 파일 또는 폴더가 이미 있습니다."
          }
        }
      }
    },
    "unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changing the workspace is unavailable in this conversation."
          }
        },
        "zh-Hans": {
