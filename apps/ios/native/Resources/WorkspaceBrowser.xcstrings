    "delete_warning": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanently delete this folder and everything inside it? This cannot be undone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "永久删除此文件夹及其全部内容？此操作无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "永久刪除此檔案夾及其所有內容？此操作無法復原。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このフォルダと内容を完全に削除しますか？取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더와 모든 내용을 영구 삭제할까요? 되돌릴 수 없습니다."
          }
        }
      }
    },
    "edit_location_hint": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This changes the saved name or path. It does not rename or move the folder on disk."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里只修改保存的位置名称或路径，不会重命名或移动磁盘上的文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這裡只會修改儲存的位置名稱或路徑，不會重新命名或移動磁碟上的檔案夾。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存した名前やパスを変更します。実際のフォルダ名や場所は変わりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장한 이름과 경로만 변경합니다. 실제 폴더의 이름이나 위치는 바뀌지 않습니다."
          }
        }
      }
    },
