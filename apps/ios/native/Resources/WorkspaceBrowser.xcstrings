          }
        }
      }
    },
    "outside_home": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a folder inside the Linux user’s home directory."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择 Linux 用户主目录中的文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請選擇 Linux 使用者主目錄中的檔案夾。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Linux ユーザーのホーム内のフォルダを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Linux 사용자 홈 폴더 안에서 선택하세요."
          }
        }
      }
    },
    "invalid_name": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a folder name without slashes or control characters."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入不含斜杠或控制字符的文件夹名称。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請輸入不含斜線或控制字元的檔案夾名稱。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スラッシュや制御文字を含まないフォルダ名を入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "슬래시와 제어 문자 없이 폴더 이름을 입력하세요."
          }
        }
      }
    },
    "in_use": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This folder is used by the runtime, a project or a session and cannot be renamed or deleted here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件夹被运行时、项目或会话使用，无法在这里重命名或删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此檔案夾正由執行環境、專案或工作階段使用，無法在此重新命名或刪除。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このフォルダは実行環境、プロジェクト、セッションで使用されています。名前の変更や削除はできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "런타임, 프로젝트 또는 세션에서 사용하는 폴더는 여기서 이름을 바꾸거나 삭제할 수 없습니다."
          }
        }
      }
    },
    "not_directory": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This folder is unavailable. Refresh the list or choose another location."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件夹不可用，请刷新列表或选择其他位置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此檔案夾無法使用，請重新整理列表或選擇其他位置。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダが利用できません。更新するか、別の場所を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더를 사용할 수 없습니다. 새로 고치거나 다른 위치를 선택하세요."
          }
        }
      }
    },
    "already_exists": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A file or folder with this name already exists."
          }
        },
        "zh-Hans": {
