{
  "name": "lingxi-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "docs:sync": "node scripts/sync-docs.mjs",
    "docs:check": "node scripts/sync-docs.mjs --check",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "node --import tsx --test test/*.test.ts",
    "docs:check:content": "node scripts/sync-docs.mjs --check --content-only",
    "docs:examples": "python3 scripts/check-doc-examples.py",
    "docs:rustdoc": "python3 scripts/build-rustdoc.py"
  },
  "dependencies": {
    "@noble/hashes": "1.8.0",
    "firebase": "^13.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^5.2.0",
    "react-test-renderer": "18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^7.3.6"
  }
}
