# Generated UniFFI integration artifacts (reproduce with scripts/build-jni.sh).
# The Rust cdylib .so (per-ABI, ~20MB each) and the uniffi-bindgen Kotlin
# bindings are build outputs, not source — mirrors clients/ios's Generated/.
app/src/main/jniLibs/
app/src/direct/jniLibs/
app/src/play/jniLibs/
app/src/main/java/com/lingxi/code/bindings/

.gradle/
build/
app/build/
local.properties
.idea/
*.iml
.DS_Store
.kotlin/
captures/
*.apk

# Device-acceptance secret: the write-scoped PAT for the Git auth tests is
# written here locally and read by the test runner — never committed.
.gittoken
app/libs/*.aar
