<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Device-audio layer (extracted voice subsystem): system STT consumes the
         live mic; the SCO controller changes audio mode and routes to a BT
         headset's voice-call channel. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />

    <!-- Device-vision layer: CAMERA for live capture; READ_MEDIA_IMAGES for the
         photo-library pick on Android 13+ (the system photo picker itself needs
         no permission, but the legacy gallery fallback does), with the pre-33
         READ_EXTERNAL_STORAGE capped for older devices. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Device-notifications layer: POST_NOTIFICATIONS for engine-driven local
         notifications (tool-notification posts via NotificationManager). Runtime
         permission required on Android 13+ (TIRAMISU); the controller gates on it
         and returns PermissionDenied when not granted. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Connectivity layer: ACCESS_NETWORK_STATE backs the dismissible offline
         banner driven by ConnectivityManager.NetworkCallback. Read-only — it only
         observes whether a validated network is available; it never hard-blocks. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- INTERNET: the engine reaches the LLM API and the in-process Git tool
         (libgit2) clones/fetches/pushes over HTTPS/SSH. Without it, native
         getaddrinfo is denied by netd ("No address associated with hostname"). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Cron scheduling layer. The desktop runs a long-lived tick loop; a phone
         cannot, so cron jobs fire from an exact AlarmManager alarm that wakes a
         foreground service to run the due jobs through a headless engine.
         USE_EXACT_ALARM (Android 13+) grants exact alarms for this core scheduling
         feature with no user prompt and no revocation; SCHEDULE_EXACT_ALARM covers
         Android 12 (31-32), where it is user-revocable (we gate + fall back to an
         inexact alarm). RECEIVE_BOOT_COMPLETED re-arms the next alarm after a
         reboot / app update (alarms don't survive either). WAKE_LOCK keeps the
         fired turn running if the device idles. The fired turn builds an engine
         and does network LLM/tool work — far past a BroadcastReceiver's ~10s
         budget — so it runs in a `dataSync` foreground service. -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- Android 11+ package visibility: SpeechRecognizer checks for an
         installed RecognitionService before opening a realtime session. This
         intent query makes the system-selected service visible without naming
         or granting access to any vendor package. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LingXiCode">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.LingXiCode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Device-share layer: exposes JPEG bytes (written under
             cache/shared_images) to the chooser target via a content:// Uri.
             The authority is ${applicationId}.fileprovider so it tracks the
             debug applicationIdSuffix; ShareController derives the same string
             from the runtime package name. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Cron: AlarmManager's exact PendingIntent targets this receiver. Not
             exported — only our own alarms reach it. -->
        <receiver
            android:name=".cron.CronAlarmReceiver"
            android:exported="false" />

        <!-- Cron: re-arm the next alarm after reboot / app replacement. Exported
             so the system can deliver BOOT_COMPLETED; guarded by the permission +
             the intent-filter actions. It ONLY arms the alarm (never starts the
             foreground service — Android 14 forbids that from a boot receiver). -->
        <receiver
            android:name=".cron.CronBootReceiver"
            android:exported="true"
            android:permission="android.permission.RECEIVE_BOOT_COMPLETED">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Cron: the headless engine run for a fired job. `dataSync` = a bounded
             network sync-like task. Not exported. -->
        <service
            android:name=".cron.CronRunService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>

</manifest>
