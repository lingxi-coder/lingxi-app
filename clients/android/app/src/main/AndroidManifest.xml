<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Device-audio layer (extracted voice subsystem): system STT consumes the
         live mic; the SCO controller changes audio mode and routes to a BT
         headset's voice-call channel. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />

    <!-- Device-vision layer: CAMERA for live capture; READ_MEDIA_IMAGES for the
         photo-library pick on Android 13+ (the system photo picker itself needs
         no permission, but the legacy gallery fallback does), with the pre-33
         READ_EXTERNAL_STORAGE capped for older devices. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Device-notifications layer: POST_NOTIFICATIONS for engine-driven local
         notifications (tool-notification posts via NotificationManager). Runtime
         permission required on Android 13+ (TIRAMISU); the controller gates on it
         and returns PermissionDenied when not granted. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- A user-started LLM/agent turn is not cancelled when the Activity moves
         behind another app. `specialUse` is used because the work can combine
         local inference, network streaming, shell tools, and file processing;
         no narrower Android foreground-service type covers that whole turn. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Native offloads: the shared permission gate must authorize each call
         before these Android runtime permissions are requested or consumed. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Connectivity layer: ACCESS_NETWORK_STATE backs the dismissible offline
         banner driven by ConnectivityManager.NetworkCallback. Read-only — it only
         observes whether a validated network is available; it never hard-blocks. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- INTERNET: the engine reaches the LLM API and the in-process Git tool
         (libgit2) clones/fetches/pushes over HTTPS/SSH. Without it, native
         getaddrinfo is denied by netd ("No address associated with hostname"). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Exact alarms are user-authorized. They only wake a receiver; persistent
         execution, network waiting and retry are delegated to WorkManager. When
         permission is denied a single 15-minute watchdog remains active. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- Android 11+ package visibility: SpeechRecognizer checks for an
         installed RecognitionService before opening a realtime session. This
         intent query makes the system-selected service visible without naming
         or granting access to any vendor package. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/local_apps_network_security"
        android:supportsRtl="true"
        android:theme="@style/Theme.LingXiCode">

        <service
            android:name=".conversation.ConversationTurnService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started LLM inference and agent tool execution" />
        </service>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.LingXiCode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="open_terminal"
                    android:scheme="lingxi" />
            </intent-filter>
        </activity>

        <!-- Device-share layer: exposes JPEG bytes (written under
             cache/shared_images) to the chooser target via a content:// Uri.
             The authority is ${applicationId}.fileprovider so it tracks the
             debug applicationIdSuffix; ShareController derives the same string
             from the runtime package name. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Cron: AlarmManager's exact PendingIntent targets this receiver. Not
             exported — only our own alarms reach it. -->
        <receiver
            android:name=".cron.CronAlarmReceiver"
            android:exported="false" />

        <!-- Cron reconciliation after lifecycle and wall-clock changes. This
             receiver only enqueues WorkManager work; it never opens an engine. -->
        <receiver
            android:name=".cron.CronBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
