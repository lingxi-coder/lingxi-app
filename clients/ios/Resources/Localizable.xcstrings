        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Credential is configured in the local secure enclave; network connectivity hasn't been verified yet"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証情報は端末のセキュアな領域に設定されていますが、ネットワーク接続の確認はまだ行われていません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자격 증명이 기기 내 보안 영역에 설정되었지만, 아직 네트워크 연결 확인은 수행하지 않았습니다"
          }
        }
      }
    },
