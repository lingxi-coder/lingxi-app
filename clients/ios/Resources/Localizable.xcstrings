    "settings_linux_detail_legacy_android": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Minijail + 现有 shell 路径保持不变；Mobile Linux 迁移仅接入到 phase-1 管理面板。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Minijail + 現有 shell 路徑保持不變；Mobile Linux 遷移僅接入到 phase-1 管理面板。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Minijail plus the existing shell path stays unchanged; the Mobile Linux migration is only wired into the phase-1 management panel."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Minijail + 既存の shell パスは変更されません。Mobile Linux への移行は phase-1 の管理パネルにのみ接続されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Minijail + 기존 셸 경로는 그대로 유지됩니다. Mobile Linux 마이그레이션은 phase-1 관리 패널에만 연결되어 있습니다."
