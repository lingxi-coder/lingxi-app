    "settings_linux_execution_boundary_sub": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iSH / fakefs 不是安全边界；真实边界仍是 iOS App 沙箱与宿主策略"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iSH / fakefs 不是安全邊界；真實邊界仍是 iOS App 沙箱與宿主策略"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iSH/fakefs isn't a security boundary — the real boundary is still the iOS app sandbox and host policy"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iSH / fakefs はセキュリティ境界ではありません。実際の境界は iOS アプリのサンドボックスとホストポリシーです"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iSH / fakefs는 보안 경계가 아니며, 실제 경계는 여전히 iOS 앱 샌드박스와 호스트 정책입니다"
          }
        }
      }
    },
    "settings_linux_execution_boundary_sub_android": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PRoot 不是安全边界；真实边界仍是 Android App 沙箱与外层 Minijail 策略"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "PRoot 不是安全邊界；真實邊界仍是 Android App 沙箱與外層 Minijail 策略"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PRoot isn't a security boundary — the real boundary is still the Android app sandbox and the outer Minijail policy"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PRoot はセキュリティ境界ではありません。実際の境界は Android アプリのサンドボックスと外側の Minijail ポリシーです"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PRoot는 보안 경계가 아니며, 실제 경계는 여전히 Android 앱 샌드박스와 외부 Minijail 정책입니다"
          }
        }
