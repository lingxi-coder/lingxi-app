    "settings_provider_pending_footer": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "URL、模型、启用状态或默认提供商已写入本机配置；重连后才会用于新请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "URL、模型、啟用狀態或預設提供商已寫入本機配置；重連後才會用於新請求。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The URL, model, enabled state, or default provider has been written to the local configuration — it only takes effect for new requests after reconnecting."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "URL、モデル、有効状態、デフォルトプロバイダーはローカル設定に書き込まれています。再接続後、新しいリクエストに使用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "URL, 모델, 활성화 상태 또는 기본 제공업체가 기기 설정에 기록되었습니다. 재연결 후에야 새 요청에 사용됩니다."
          }
        }
      }
    },
    "settings_provider_picker_intro": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择一个预设 — 灵犀会自动预填 API 地址、Key 前缀和可用模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇一個預設 — 靈犀會自動預填 API 地址、Key 字首和可用模型。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a preset — Lingxi will pre-fill the API URL, key prefix, and available models."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プリセットを選択してください — 灵犀が API アドレス、Key のプレフィックス、利用可能なモデルを自動的に入力します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프리셋을 선택하면 灵犀가 API 주소, Key 접두사, 사용 가능한 모델을 자동으로 채워 줍니다."
          }
        }
      }
    },
    "settings_provider_picker_unavailable": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此类别尚未开放新增。"
          }
        },
