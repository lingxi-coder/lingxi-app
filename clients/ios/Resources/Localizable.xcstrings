    "settings_platform_note_1": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 iOS 公共 API，动作会由系统展示和授权。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 iOS 公共 API，動作會由系統展示和授權。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses public iOS APIs — actions are presented and authorized by the system."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS の公開 API を使用し、アクションはシステムによって表示・承認されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 공개 API를 사용하며, 동작은 시스템이 표시하고 승인합니다."
          }
        }
      }
    },
    "settings_platform_note_2": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不会读取、点击或控制其他 App 的界面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不會讀取、點選或控制其他 App 的介面。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Never reads, taps, or controls the UI of other apps."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他のアプリの画面を読み取ったり、タップしたり、操作したりすることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 앱의 화면을 읽거나 탭하거나 제어하지 않습니다."
          }
        }
      }
    },
    "settings_platform_note_3": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跨 App 数据通过快捷指令输入或系统分享完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "跨 App 資料透過快捷指令輸入或系統分享完成。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cross-app data flows through Shortcuts input or the system share sheet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリをまたぐデータのやり取りは、ショートカットの入力またはシステムの共有機能を通じて行われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 간 데이터는 단축어 입력 또는 시스템 공유를 통해서만 전달됩니다."
          }
        }
      }
    },
    "settings_privacy_footer": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "灵犀对你的承诺：密钥永远不离开本机；对话默认不被用于训练。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "靈犀對你的承諾：金鑰永遠不離開本機；對話預設不被用於訓練。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Our promise to you: your keys never leave this device, and your conversations aren't used for training by default."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "灵犀からのお約束：API キーが端末の外に出ることはありません。会話はデフォルトで学習には利用されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "灵犀의 약속: 키는 절대 기기 밖으로 나가지 않으며, 대화는 기본적으로 학습에 사용되지 않습니다."
          }
        }
      }
    },
