    "local_apps_data_sqlite_detail": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "页面和 Agent 只能通过受控 collection API 查询和修改，不接受原始 SQL。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "頁面和 Agent 只能透過受控 collection API 查詢和修改，不接受原始 SQL。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pages and agents can only query and modify data through the controlled collection API — raw SQL isn't accepted."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ページと Agent は制御された collection API を通じてのみ照会・変更ができ、生の SQL は受け付けません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페이지와 에이전트는 제어된 collection API로만 조회하고 수정할 수 있으며, 원시 SQL은 허용되지 않습니다."
          }
        }
      }
    },
