    "local_apps_source_browser_notice": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅显示 1 MiB 以内的文本源码；符号链接、构建产物和私有目录已排除。依赖文件可编辑，但不受支持的版本会在构建校验时被拒绝。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅顯示 1 MiB 以內的文字原始碼；符號連結、建置產物和私有目錄已排除。依賴檔案可編輯，但不受支援的版本會在建置校驗時被拒絕。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only text source under 1 MiB is shown; symlinks, build artifacts, and private directories are excluded. Dependency files are editable, but unsupported versions are rejected during build verification."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 MiB 以内のテキストソースコードのみを表示します。シンボリックリンク、ビルド成果物、非公開ディレクトリは除外されています。依存関係ファイルは編集できますが、サポート対象外のバージョンはビルド検証時に拒否されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1 MiB 이하의 텍스트 소스 코드만 표시됩니다. 심볼릭 링크, 빌드 결과물, 비공개 디렉터리는 제외됩니다. 의존성 파일은 편집할 수 있지만, 지원되지 않는 버전은 빌드 검증 시 거부됩니다."
          }
        }
      }
    },
    "local_apps_source_detail": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可查看和编辑完整文本源码；符号链接、构建产物和工作区外路径不会显示。修改固定依赖可以保存，但构建验证会拒绝不受支持的版本或安装操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可檢視和編輯完整文字原始碼；符號連結、建置產物和工作區外路徑不會顯示。修改固定依賴可以儲存，但建置驗證會拒絕不受支援的版本或安裝操作。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "View and edit the full text source; symlinks, build artifacts, and paths outside the workspace aren't shown. Changes to pinned dependencies can be saved, but build validation will reject unsupported versions or installs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完全なテキストソースコードの閲覧・編集ができます。シンボリックリンク、ビルド成果物、ワークスペース外のパスは表示されません。固定された依存関係の変更は保存できますが、サポート対象外のバージョンやインストール操作はビルド検証で拒否されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 텍스트 소스 코드를 보고 편집할 수 있습니다. 심볼릭 링크, 빌드 결과물, 작업 공간 밖의 경로는 표시되지 않습니다. 고정 의존성 수정 사항은 저장할 수 있지만, 빌드 검증에서 지원되지 않는 버전이나 설치 작업은 거부됩니다."
          }
        }
      }
    },
