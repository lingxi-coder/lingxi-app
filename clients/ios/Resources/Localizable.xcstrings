    "settings_voice_listen_footer": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "聊天麦克风和 Computer Use 的 listen 动作共用此设置。麦克风权限只可由用户在前台授予。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "聊天麥克風和 Computer Use 的 listen 動作共用此設定。麥克風權限只可由使用者在前景授予。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This setting is shared by the chat microphone and Computer Use's listen action. Microphone permission can only be granted by the user in the foreground."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャットのマイクと Computer Use の listen アクションはこの設定を共有します。マイクの権限はユーザーがフォアグラウンドで許可した場合のみ付与されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "채팅 마이크와 Computer Use의 listen 동작은 이 설정을 공유합니다. 마이크 권한은 사용자가 포그라운드에서만 부여할 수 있습니다."
          }
        }
      }
    },
