          }
        }
      }
    },
    "settings_cu_background_exec_sub": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅活动会话内；Cron/WorkManager 不会自行创建授权"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅活動會話內；Cron/WorkManager 不會自行建立授權"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Within an active session only; Cron/WorkManager can't create authorization on their own"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクティブなセッション内のみ有効です。Cron／WorkManager が独自に許可を作成することはありません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성 세션 내에서만; Cron/WorkManager는 스스로 권한을 만들지 않습니다"
          }
        }
      }
    },
    "settings_cu_boundary_footer": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后台能力不会绕过会话授权：停止会话、锁屏、服务断开或超时会取消排队动作和正在进行的音频。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "背景能力不會繞過會話授權：停止會話、螢幕鎖定、服務斷開或逾時會取消排隊動作和正在進行的音訊。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Background capability never bypasses session authorization: stopping the session, locking the screen, a service disconnect, or a timeout will cancel queued actions and any audio in progress."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックグラウンド機能はセッションの許可を回避しません。セッションの停止、画面ロック、サービスの切断、タイムアウトが発生すると、待機中のアクションと進行中のオーディオはキャンセルされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백그라운드 기능은 세션 권한을 우회하지 않습니다. 세션 중지, 화면 잠금, 서비스 연결 끊김, 시간 초과 시 대기 중인 동작과 진행 중인 오디오가 취소됩니다."
          }
        }
      }
    },
    "settings_cu_capture_cancelled": {
