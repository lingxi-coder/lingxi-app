    "skills_description_blurb": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Skills 是可复用的 AI 行为包，封装了系统提示词、工具调用与触发条件。启用后会出现在对应触发器或斜杠菜单。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Skills 是可複用的 AI 行為包，封裝了系統提示詞、工具呼叫與觸發條件。啟用後會出現在對應觸發器或斜槓選單。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skills are reusable AI behavior packs that bundle system prompts, tool calls, and trigger conditions. Once enabled, they appear in their matching trigger or slash-command menu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Skills は再利用可能な AI 行動パッケージで、システムプロンプト・ツール呼び出し・トリガー条件をひとまとめにしたものです。有効にすると、対応するトリガーやスラッシュメニューに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Skills는 재사용 가능한 AI 행동 모음으로, 시스템 프롬프트와 도구 호출, 트리거 조건을 담고 있습니다. 활성화하면 해당 트리거나 슬래시 메뉴에 표시됩니다."
          }
        }
      }
    },
