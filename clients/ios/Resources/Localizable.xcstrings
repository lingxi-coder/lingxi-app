    "provider_fetch_blurb": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "抓取网页正文用于阅读、摘要、引用 — 推荐 Jina Reader（免费）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "抓取網頁正文用於閱讀、摘要、引用 — 推薦 Jina Reader（免費）。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fetches web page content for reading, summarizing, and citing — Jina Reader (free) is recommended."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウェブページの本文を取得して、読み込み・要約・引用に利用します — Jina Reader（無料）がおすすめです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "웹 페이지 본문을 가져와 읽기, 요약, 인용에 사용합니다 — Jina Reader(무료)를 추천합니다."
          }
        }
      }
    },
    "provider_llm_blurb": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "灵犀本身不调用云端 LLM — 由你添加的提供商完成推理。密钥仅本机加密。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "靈犀本身不呼叫雲端 LLM — 由你新增的提供商完成推理。金鑰僅本機加密。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingxi doesn't call any cloud LLM on its own — inference is handled by the providers you add. Keys are encrypted locally only."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "灵犀自体はクラウド LLM を呼び出しません — 推論はあなたが追加したプロバイダーが行います。API キーは端末内で暗号化して保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "灵犀는 클라우드 LLM을 직접 호출하지 않으며, 추가한 제공업체가 추론을 수행합니다. 키는 기기에서만 암호화되어 저장됩니다."
          }
        }
      }
    },
    "provider_no_providers_added": {
