          }
        }
      }
    },
    "oss_android_bundle_body": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本 Android 组合产品按 GNU GPLv3 分发。原有 MIT、Apache、LGPL 及 Alpine 软件包继续保留各自声明。构建产物同时携带 NOTICE、SPDX SBOM、固定摘要和对应源码信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本 Android 組合產品按 GNU GPLv3 分發。原有 MIT、Apache、LGPL 及 Alpine 軟體包繼續保留各自宣告。建置產物同時攜帶 NOTICE、SPDX SBOM、固定摘要和對應原始碼資訊。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Android bundle is distributed under the GNU GPLv3. The original MIT, Apache, LGPL, and Alpine packages retain their own license notices. Build artifacts include a NOTICE file, SPDX SBOM, pinned checksums, and corresponding source information."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Android 統合製品は GNU GPLv3 の下で配布されます。元の MIT、Apache、LGPL、および Alpine パッケージは、それぞれの表示を引き続き保持します。ビルド成果物には NOTICE、SPDX SBOM、固定ダイジェスト、対応ソースコード情報が含まれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Android 번들 제품은 GNU GPLv3에 따라 배포됩니다. 기존 MIT, Apache, LGPL 및 Alpine 패키지는 각자의 라이선스 조항을 그대로 유지합니다. 빌드 결과물에는 NOTICE, SPDX SBOM, 고정된 다이제스트 및 해당 소스 코드 정보가 함께 포함됩니다."
          }
        }
