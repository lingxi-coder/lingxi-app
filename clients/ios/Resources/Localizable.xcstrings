    "settings_linux_stop_task_sub_android": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未授权或 runtime 未链接时必须 fail-closed；不会静默回退到 legacy shell"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未授權或 runtime 未連結時必須 fail-closed；不會靜默回退到 legacy shell"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Must fail closed when unauthorized or the runtime isn't linked — never silently falls back to the legacy shell"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可がない、またはランタイムが未接続の場合は必ず fail-closed になります。legacy shell へ黙って切り替わることはありません"
          }
        },
        "ko": {
          "stringUnit": {
