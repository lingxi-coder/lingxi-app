    "onboarding_done_subtitle": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "进入应用后，请在「设置 → LLM 提供商」保存真实凭据并选择默认模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "進入應用後，請在「設定 → LLM 提供商」儲存真實憑據並選擇預設模型。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once you're in the app, go to Settings → LLM Providers to save your credentials and choose a default model."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリに入ったら、「設定 → LLM プロバイダー」で実際の認証情報を保存し、デフォルトモデルを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱에 들어간 후 「설정 → LLM 제공업체」에서 실제 자격 증명을 저장하고 기본 모델을 선택해 주세요."
          }
        }
      }
    },
    "onboarding_done_subtitle_detail": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "进入应用后，请在「设置 → AI 提供商」保存真实凭据并选择默认模型。模型列表会直接来自当前已配置的提供商。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "進入應用後，請在「設定 → AI 提供商」儲存真實憑據並選擇預設模型。模型列表會直接來自當前已配置的提供商。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After entering the app, save your real credentials and choose a default model under “Settings → AI Providers.” The model list comes directly from your currently configured providers."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリに入ったら、「設定 → AI プロバイダー」で実際の認証情報を保存し、デフォルトモデルを選択してください。モデル一覧は現在設定済みのプロバイダーから直接取得されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱에 들어간 후 「설정 → AI 제공업체」에서 실제 자격 증명을 저장하고 기본 모델을 선택해 주세요. 모델 목록은 현재 설정된 제공업체에서 바로 가져옵니다."
          }
        }
      }
    },
