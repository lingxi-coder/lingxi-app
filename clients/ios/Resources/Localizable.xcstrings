    "settings_provider_fallback_hint": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用至少一个非默认 Provider 并设置模型后，才能为默认模型配置 fallback。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用至少一個非預設 Provider 並設定模型後，才能為預設模型配置 fallback。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable at least one non-default provider and set a model before configuring fallback for the default model."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デフォルト以外の Provider を少なくとも 1 つ有効にしてモデルを設定すると、デフォルトモデルのフォールバックを設定できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본값이 아닌 Provider를 하나 이상 활성화하고 모델을 설정해야 기본 모델의 폴백을 구성할 수 있습니다."
