    "onboarding_voice_subtitle": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择识别方式和系统播报声音；心流模式会自动听取并朗读回复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇識別方式和系統播報聲音；心流模式會自動聽取並朗讀回覆。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a recognition method and system playback voice; Flow Mode will automatically listen and read replies aloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認識方式とシステムの読み上げ音声を選択してください。心流モードでは自動的に聞き取り、返信を読み上げます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인식 방식과 시스템 음성 안내를 선택하세요. 심리스 모드에서는 자동으로 듣고 응답을 읽어 줍니다."
          }
        }
      }
    },
