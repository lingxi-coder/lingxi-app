    "local_apps_capability_section_detail": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首次修改数据、控制 UI 或访问声明域名时，系统会提供允许一次、本次会话或始终允许。未授权请求默认拒绝。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "首次修改資料、控制 UI 或存取宣告域名時，系統會提供允許一次、本次會話或始終允許。未授權請求預設拒絕。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first time the app modifies data, controls the UI, or accesses a declared domain, you'll be offered allow once, allow this session, or always allow. Unauthorized requests are denied by default."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "初めてデータを変更したり、UI を操作したり、宣言済みのドメインにアクセスする際、システムは「1 回だけ許可」「このセッションのみ許可」「常に許可」を提示します。許可されていないリクエストはデフォルトで拒否されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터를 처음 수정하거나 UI를 제어하거나 명시된 도메인에 접근할 때, 한 번 허용 · 이번 세션 · 항상 허용 중에서 선택할 수 있습니다. 권한이 없는 요청은 기본적으로 거부됩니다."
          }
        }
      }
    },
