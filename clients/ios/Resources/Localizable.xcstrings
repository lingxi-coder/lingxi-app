    "local_apps_history_notice": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复只回退 Git 管理的源码，SQLite 数据不会回滚。恢复前会自动创建 pre_restore 检查点。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "恢復只回退 Git 管理的原始碼，SQLite 資料不會回滾。恢復前會自動建立 pre_restore 檢查點。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restoring only rolls back Git-managed source code; SQLite data is not rolled back. A pre_restore checkpoint is created automatically before restoring."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復元は Git で管理されたソースコードのみを巻き戻し、SQLite データはロールバックされません。復元前に pre_restore チェックポイントが自動的に作成されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복원은 Git으로 관리되는 소스 코드만 되돌리며, SQLite 데이터는 되돌아가지 않습니다. 복원 전에 pre_restore 체크포인트가 자동으로 생성됩니다."
          }
        }
      }
    },
