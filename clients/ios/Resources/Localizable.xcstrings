    "cron_scheduler_background_note": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 后台任务只保证“不会早于”最早执行时间，不保证准点启动；始终可以立即运行。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS background tasks only guarantee “no earlier than” the earliest run time — exact start times aren't guaranteed, but you can always run a task immediately."
          }
        }
      }
    },
    "cron_scheduler_foreground_note": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统调度不是精确闹钟；App 启动、回到前台和后台唤醒时都会巡检，且始终可以立即运行。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System scheduling isn't a precise alarm; checks run on app launch, returning to the foreground, and background wake-ups, and you can always run a task immediately."
          }
        }
      }
    },
