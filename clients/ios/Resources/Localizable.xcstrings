          }
        }
      }
    },
    "onboarding_voice_pack_subtitle": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载离线语音模型后，听写与朗读完全在本机进行、不依赖网络。可稍后在设置里更换或删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "下載離線語音模型後，聽寫與朗讀完全在本機進行、不依賴網路。可稍後在設定裡更換或刪除。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once an offline voice model is downloaded, dictation and read-aloud run entirely on-device with no network dependency. You can change or remove it later in Settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフライン音声モデルをダウンロードすると、音声入力と読み上げが完全に端末内で完結し、ネットワークに依存しなくなります。後で設定から変更・削除できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오프라인 음성 모델을 다운로드하면 받아쓰기와 낭독이 완전히 기기 내에서 처리되어 네트워크가 필요 없습니다. 나중에 설정에서 변경하거나 삭제할 수 있습니다."
          }
        }
      }
    },
