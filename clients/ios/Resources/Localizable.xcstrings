    "settings_linux_terminal_footer": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "终端使用当前项目的 guest workspace；运行时或 PTY 不可用时会显示修复入口，不会回退到其他目录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "終端使用當前專案的 guest workspace；執行時或 PTY 不可用時會顯示修復入口，不會回退到其他目錄。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The terminal uses the current project's guest workspace; if the runtime or PTY is unavailable, a repair entry point is shown instead of falling back to another directory."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターミナルは現在のプロジェクトの guest workspace を使用します。ランタイムまたは PTY が利用できない場合は修復画面が表示され、他のディレクトリへのフォールバックは行いません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터미널은 현재 프로젝트의 guest workspace를 사용합니다. 런타임이나 PTY를 사용할 수 없으면 복구 진입점이 표시되며, 다른 디렉터리로 대체되지 않습니다."
          }
        }
      }
    },
