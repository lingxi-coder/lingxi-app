        }
      }
    },
    "chat_compaction_status": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上下文已压缩：%1$d → %2$d 条，释放 %3$s"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上下文已壓縮：%1$d → %2$d 條，釋放 %3$s"
          }
        },
        "en": {
