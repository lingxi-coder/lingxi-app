    "project_corrupt_projects_message_fmt": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d 个项目数据损坏或路径异常，已隔离；其他项目仍可使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d 個專案資料損壞或路徑異常，已隔離；其他專案仍可使用。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d project(s) had corrupted data or an invalid path and were quarantined; other projects remain usable."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d 件のプロジェクトデータが破損またはパスに異常があるため、隔離しました。他のプロジェクトは引き続き利用できます。"
          }
