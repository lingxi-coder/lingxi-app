    "local_apps_runtime_notice_staged_after_null": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地应用运行时已准备就绪，但本次启动中曾有一次引擎构建没能拿到它。引擎只在启动时读取一次运行时路径：如果失败原因是运行时不可用，请重启 App 后重试；否则本次失败与运行时无关。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The local-app runtime is ready, but during this launch one engine build failed to pick it up. The engine reads the runtime path only once at launch: if the failure was caused by the runtime being unavailable, restart the app and try again; otherwise this failure is unrelated to the runtime."
          }
        }
      }
    },
    "local_apps_runtime_notice_staging": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地应用运行时仍在首次准备中。引擎只在启动时读取一次运行时路径，因此准备完成后需要重启 App 才能生成应用。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The local-app runtime is still being prepared for the first time. The engine reads the runtime path only once at launch, so you'll need to restart the app after preparation finishes before you can generate apps."
          }
        }
      }
    },
    "local_apps_runtime_notice_unavailable": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地应用运行时准备失败（安装包中没有运行时，或解压失败），本次启动无法生成应用。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The local-app runtime failed to prepare (the install package has no runtime, or extraction failed); apps can't be generated during this launch."
