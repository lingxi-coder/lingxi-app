          }
        }
      }
    },
    "cron_scheduler_background_note": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 后台任务只保证“不会早于”最早执行时间，不保证准点启动；始终可以立即运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 背景任務只保證「不會早於」最早執行時間，不保證準點啟動；始終可以立即執行。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS background tasks only guarantee “no earlier than” the earliest run time — exact start times aren't guaranteed, but you can always run a task immediately."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS のバックグラウンドタスクは「最短実行時刻より早くならない」ことのみを保証し、定刻での起動は保証されません。いつでも今すぐ実行できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 백그라운드 작업은 최소 실행 시각을 보장할 뿐, 정시 시작은 보장하지 않습니다. 언제든 즉시 실행할 수 있습니다."
          }
        }
      }
    },
    "cron_scheduler_foreground_note": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统调度不是精确闹钟；App 启动、回到前台和后台唤醒时都会巡检，且始终可以立即运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統排程不是精確鬧鐘；App 啟動、回到前景和背景喚醒時都會巡檢，且始終可以立即執行。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System scheduling isn't a precise alarm; checks run on app launch, returning to the foreground, and background wake-ups, and you can always run a task immediately."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムスケジュールは正確なアラームではありません。アプリの起動時、フォアグラウンド復帰時、バックグラウンド起動時に巡回チェックが行われ、いつでも今すぐ実行できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 예약은 정확한 알람이 아닙니다. 앱 실행, 포그라운드 복귀, 백그라운드 깨우기 시마다 점검하며, 언제든 즉시 실행할 수 있습니다."
          }
        }
      }
    },
