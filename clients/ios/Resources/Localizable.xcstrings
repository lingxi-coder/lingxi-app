    "mcp_description_blurb": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "MCP (Model Context Protocol) 是连接外部工具的开放协议。已连接的服务器会向 AI 暴露工具调用能力。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "MCP (Model Context Protocol) 是連線外部工具的開放協議。已連線的伺服器會向 AI 暴露工具呼叫能力。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MCP (Model Context Protocol) is an open protocol for connecting external tools. Connected servers expose tool-calling capabilities to the AI."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MCP（Model Context Protocol）は外部ツールと接続するためのオープンプロトコルです。接続済みのサーバーは AI にツール呼び出し機能を提供します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "MCP(Model Context Protocol)는 외부 도구를 연결하는 개방형 프로토콜입니다. 연결된 서버는 AI에 도구 호출 기능을 제공합니다."
          }
        }
      }
    },
