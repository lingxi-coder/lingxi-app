    "settings_provider_unsupported_notice %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 当前版本只移除了原型卡片；%@ 会显示真实空状态，待对应后端与会话重连链路接入后再开放新增与编辑。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 當前版本只移除了原型卡片；%@ 會顯示真實空狀態，待對應後端與會話重連鏈路接入後再開放新增與編輯。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This iOS version only removes the prototype cards; %@ shows a real empty state until the corresponding backend and reconnect flow are wired up, at which point adding and editing will open."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS の現在のバージョンではプロトタイプカードのみを削除しています。%@ には実際の空状態が表示され、対応するバックエンドとセッション再接続の仕組みが接続され次第、追加・編集が可能になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 iOS 버전에서는 프로토타입 카드만 제거되었습니다. %@는 실제 빈 상태로 표시되며, 해당 백엔드와 세션 재연결 경로가 연결된 후에 추가 및 편집이 열립니다."
          }
        }
      }
    },
