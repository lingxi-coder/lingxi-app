    "settings_provider_hint_local_only": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索/抓取 provider 仍是本地配置页；当前未接入真实 engine credential 协议。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "搜尋/抓取 provider 仍是本地配置頁；當前未接入真實 engine credential 協議。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search/fetch providers are still a local configuration page — the real engine credential protocol isn't connected yet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検索／フェッチの provider は現在ローカル設定ページのままで、実際のエンジン認証情報プロトコルにはまだ接続されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "웹 검색/가져오기 provider는 아직 로컬 설정 화면이며, 실제 engine credential 프로토콜에는 연결되지 않았습니다."
          }
        }
      }
    },
    "settings_provider_hint_not_in_catalog": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该预设当前不在 Android 内建 provider catalog 中；需后续 bridge/profile 扩展。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該預設當前不在 Android 內建 provider catalog 中；需後續 bridge/profile 擴充。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This preset isn't in the built-in Android provider catalog yet — it needs a future bridge/profile extension."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプリセットは現在 Android 内蔵の provider catalog に含まれていません。今後の bridge／profile 拡張が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 프리셋은 현재 Android 내장 provider catalog에 없습니다. 추후 bridge/profile 확장이 필요합니다."
          }
        }
      }
    },
    "settings_provider_hint_overwrite": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安全存储不会回传明文；输入新 Key 可覆盖当前凭据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安全儲存不會回傳明文；輸入新 Key 可覆蓋當前憑據。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Secure storage never returns plaintext — enter a new key to overwrite the current credential."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セキュアストレージは平文を返しません。新しい Key を入力すると現在の認証情報を上書きできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보안 저장소는 평문을 다시 보여주지 않습니다. 새 Key를 입력하면 현재 자격 증명을 덮어씁니다."
          }
        }
      }
    },
    "settings_provider_hint_secure_store": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "凭据保存到引擎共享安全存储；Anthropic 还会镜像到当前启动兼容 key 槽。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "憑據儲存到引擎共享安全儲存；Anthropic 還會鏡像到當前啟動相容 key 槽。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Credentials are saved to the engine's shared secure storage; for Anthropic, they're also mirrored to the current launch-compatible key slot."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証情報はエンジン共有のセキュアストレージに保存されます。Anthropic の場合は、起動互換用の key スロットにもミラーされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자격 증명은 엔진 공용 보안 저장소에 저장됩니다. Anthropic은 현재 실행 중 호환 key 슬롯에도 미러링됩니다."
          }
        }
      }
    },
    "settings_provider_keep_key": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留"
          }
        },
        "zh-Hant": {
