          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "灵犀에게 이름을 지어주세요"
          }
        }
      }
    },
    "onboarding_assistant_wake_hint": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会成为它的唤醒词。之后你可以说「嘿，%1$s」随时唤醒它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會成為它的喚醒詞。之後你可以說「嘿，%1$s」隨時喚醒它。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will become its wake word. Afterward you can say “Hey, %1$s” anytime to wake it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これがウェイクワードになります。今後は「ねえ、%1$s」と話しかけると、いつでも呼び出せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이것이 호출어가 됩니다. 이후 \"헤이, %1$s\"라고 말하면 언제든 깨울 수 있습니다."
          }
        }
      }
    },
