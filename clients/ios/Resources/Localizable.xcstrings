        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Code, build artifacts, logs, and local SQLite data will all be permanently deleted."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コード、ビルド成果物、ログ、ローカルの SQLite データはすべて完全に削除されます。"
