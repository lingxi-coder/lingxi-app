    "settings_shortcuts_footer": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可在系统快捷指令中组合分享表单、剪贴板、文件或其他 App 的输出，再交给灵犀。"
