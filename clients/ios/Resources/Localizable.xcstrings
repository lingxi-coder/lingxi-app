    "local_apps_data_section_detail": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SQLite 由 Rust AppService 独占管理。页面与 Agent 只能使用 collection API；原始 SQL 不会暴露。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "SQLite 由 Rust AppService 獨佔管理。頁面與 Agent 只能使用 collection API；原始 SQL 不會暴露。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SQLite is exclusively managed by the Rust AppService. Pages and the Agent can only use the collection API; raw SQL is never exposed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SQLite は Rust AppService が単独で管理します。ページと Agent は collection API のみを使用でき、生の SQL は公開されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SQLite는 Rust AppService가 독점적으로 관리합니다. 페이지와 에이전트는 collection API만 사용할 수 있으며, 원시 SQL은 노출되지 않습니다."
          }
        }
      }
    },
