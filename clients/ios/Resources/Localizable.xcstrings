    "settings_linux_maintenance_footer": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "校验会检查 fakefs 元数据与基础命令；修复会从应用内置归档恢复缺失文件；重置只重建托管 rootfs，不会删除项目、会话或密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "校驗會檢查 fakefs 後設資料與基礎命令；修復會從應用內建歸檔恢復缺失檔案；重置只重建託管 rootfs，不會刪除專案、會話或金鑰。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verify checks fakefs metadata and basic commands; Repair restores missing files from the app's built-in archive; Reset only rebuilds the managed rootfs and never deletes projects, sessions, or keys."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検証では fakefs のメタデータと基本コマンドを確認します。修復ではアプリ内蔵アーカイブから不足ファイルを復元します。リセットは管理対象の rootfs のみを再構築し、プロジェクト・会話・キーは削除しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검증은 fakefs 메타데이터와 기본 명령을 확인하고, 복구는 앱에 내장된 아카이브에서 누락된 파일을 복원합니다. 재설정은 관리형 rootfs만 다시 생성하며 프로젝트, 세션, 키는 삭제하지 않습니다."
          }
        }
      }
    },
    "settings_linux_maintenance_footer_android": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装、修复和重置只作用于受管 rootfs；外部工作区、会话与密钥不会被删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安裝、修復和重置只作用於受管 rootfs；外部工作區、會話與金鑰不會被刪除。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install, Repair, and Reset only affect the managed rootfs — external workspaces, sessions, and keys are never deleted."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストール・修復・リセットは管理対象の rootfs にのみ作用します。外部ワークスペース、会話、キーは削除されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설치, 복구, 재설정은 관리형 rootfs에만 적용됩니다. 외부 작업 공간, 세션, 키는 삭제되지 않습니다."
          }
        }
      }
    },
