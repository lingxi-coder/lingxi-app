    "mcp_transport_description_prefix": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支持 stdio / SSE / Streamable HTTP 三种传输；OAuth、API Key、本地子进程多种鉴权。\n浏览公开服务器目录："
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "支援 stdio / SSE / Streamable HTTP 三種傳輸；OAuth、API Key、本地子行程多種驗證。\n瀏覽公開伺服器目錄："
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Supports stdio, SSE, and Streamable HTTP transports, with OAuth, API key, and local subprocess authentication.\nBrowse the public server directory:"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "stdio / SSE / Streamable HTTP の3種類の転送方式に対応し、OAuth・API Key・ローカルサブプロセスなど複数の認証方式に対応しています。\n公開サーバーディレクトリを見る："
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "stdio / SSE / Streamable HTTP 세 가지 전송 방식을 지원하며, OAuth · API Key · 로컬 서브프로세스 등 다양한 인증 방식을 지원합니다.\n공개 서버 디렉터리 둘러보기:"
          }
        }
      }
    },
