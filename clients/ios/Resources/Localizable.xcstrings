    "settings_linux_detail_default": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "真机使用 iSH ARM64 + fakefs；首次启动会安装应用内置的 Alpine rootfs。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
