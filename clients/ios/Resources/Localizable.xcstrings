    "settings_section_capabilities_footer": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Skills 是可复用的 AI 行为包；MCP 是接入外部工具的标准协议；Dream 让灵犀在你休息时主动整理与规划。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Skills 是可複用的 AI 行為包；MCP 是接入外部工具的標準協議；Dream 讓靈犀在你休息時主動整理與規劃。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skills are reusable AI behavior packs; MCP is a standard protocol for connecting external tools; Dream lets Lingxi organize and plan proactively while you rest."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Skills は再利用可能な AI 行動パッケージ、MCP は外部ツールに接続する標準プロトコルです。Dream は、休んでいる間に灵犀が自発的に整理・計画を行う機能です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Skills는 재사용 가능한 AI 행동 모음이고, MCP는 외부 도구를 연결하는 표준 프로토콜입니다. Dream은 휴식 중에도 灵犀가 알아서 정리하고 계획을 세우게 해줍니다."
          }
        }
      }
    },
