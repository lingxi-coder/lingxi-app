{
  "sourceLanguage": "zh-Hans",
  "version": "1.0",
  "strings": {
    "CFBundleDisplayName": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "灵犀"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "靈犀"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "灵犀"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "灵犀"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "灵犀"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "灵犀使用相机拍摄照片供模型分析。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "靈犀使用相機拍攝照片供模型分析。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "灵犀使用相机拍摄照片供模型分析。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "灵犀はモデルによる解析のため、カメラで写真を撮影します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "灵犀가 모델 분석을 위해 카메라로 사진을 촬영합니다."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "灵犀使用麦克风进行语音心流输入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "靈犀使用麥克風進行語音心流輸入。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "灵犀使用麦克风进行语音心流输入。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "灵犀は音声心流（フローモード）入力のためにマイクを使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "灵犀가 음성 심리스 입력(Flow Mode)을 위해 마이크를 사용합니다."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "灵犀访问相册以选择图片供模型分析。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "靈犀存取相簿以選擇圖片供模型分析。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "灵犀访问相册以选择图片供模型分析。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "灵犀はモデルによる解析のため、写真ライブラリから画像を選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "灵犀가 모델 분석에 사용할 이미지를 선택하기 위해 사진 보관함에 접근합니다."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "灵犀使用语音识别将你的语音转写为文本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "靈犀使用語音識別將你的語音轉寫為文字。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "灵犀使用语音识别将你的语音转写为文本。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "灵犀は音声認識を使用して、あなたの発話をテキストに変換します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "灵犀가 음성 인식을 사용해 사용자의 말을 텍스트로 변환합니다."
          }
        }
      }
    },
    "app_intent_ask_description": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把来自 Siri、快捷指令或其他 App 的文本带入新对话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把來自 Siri、快捷指令或其他 App 的文字帶入新對話。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring text from Siri, Shortcuts, or another app into a new conversation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri、ショートカット、または他のアプリからのテキストを新しい会話に渡します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri, 단축어 또는 다른 앱에서 전달된 텍스트를 새 대화로 가져옵니다."
          }
        }
      }
    },
    "app_intent_ask_title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向灵犀提问"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "向靈犀提問"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask Lingxi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "灵犀に質問する"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "灵犀에게 질문하기"
          }
        }
      }
    },
    "app_intent_initial_command_param_title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预填命令"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預填命令"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pre-filled Command"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "事前入力するコマンド"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미리 입력할 명령"
          }
        }
      }
    },
    "app_intent_new_conversation_description": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在当前项目中新建一个灵犀对话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在當前專案中新建一個靈犀對話。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start a new Lingxi conversation in the current project."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のプロジェクトで灵犀の新しい会話を作成します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 프로젝트에서 灵犀 새 대화를 만듭니다."
          }
        }
      }
    },
    "app_intent_new_conversation_title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新建灵犀对话"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新建靈犀對話"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New Lingxi Conversation"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "灵犀で新しい会話を作成"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "灵犀 새 대화 만들기"
          }
        }
      }
    },
    "app_intent_open_description": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开灵犀并回到当前会话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟靈犀並回到當前會話。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Lingxi and return to the current conversation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "灵犀を開いて、現在の会話に戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "灵犀를 열고 현재 대화로 돌아갑니다."
          }
        }
      }
    },
    "app_intent_open_terminal_description": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开当前项目的终端，可选择预填一条命令。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟當前專案的終端，可選擇預填一條命令。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the current project's terminal, optionally pre-filled with a command."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のプロジェクトのターミナルを開きます。コマンドをあらかじめ入力しておくこともできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 프로젝트의 터미널을 열며, 명령을 미리 입력해 둘 수도 있습니다."
          }
        }
      }
    },
    "app_intent_open_terminal_title": {
      "localizations": {
