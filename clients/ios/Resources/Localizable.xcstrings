    "provider_search_blurb": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让 AI 接入实时网页搜索 — 选择一个搜索提供商以启用\"联网\"模式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓 AI 接入實時網頁搜尋 — 選擇一個搜尋提供商以啟用\"聯網\"模式。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give the AI real-time web search — choose a search provider to enable \"Web\" mode."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AI にリアルタイムのウェブ検索を接続します — 検索プロバイダーを選択すると「ネット接続」モードが有効になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI가 실시간 웹 검색에 접근하도록 하려면 검색 제공업체를 선택해 \"웹 검색\" 모드를 활성화하세요."
          }
        }
      }
    },
