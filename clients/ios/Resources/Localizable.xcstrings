    "voice_automatic_supports_on_device": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统可按条件选择设备端或在线识别；当前语言支持设备端"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統可按條件選擇裝置端或線上識別；當前語言支援裝置端"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The system can choose on-device or online recognition as conditions allow; the current language supports on-device"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムは条件に応じてデバイス端またはオンライン認識を選択できます。現在の言語はデバイス端認識に対応しています"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템이 조건에 따라 기기 내 또는 온라인 인식을 선택할 수 있습니다. 현재 언어는 기기 내 인식을 지원합니다"
          }
        }
      }
    },
    "voice_automatic_uses_online": {
      "localizations": {
        "zh-Hans": {
