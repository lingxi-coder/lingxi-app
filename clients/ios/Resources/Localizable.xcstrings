    "onboarding_welcome_subtitle": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "花一分钟，让它认识你——之后你只需开口，它就会回应。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "花一分鐘，讓它認識你——之後你只需開口，它就會回應。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spend a minute getting acquainted — after that, just speak, and it'll respond."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 分だけ時間をかけて、灵犀にあなたのことを知ってもらいましょう。あとは話しかけるだけで応えてくれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1분만 시간을 내어 灵犀가 당신을 알게 해주세요 — 그다음부터는 말만 하면 응답합니다."
          }
        }
      }
    },
