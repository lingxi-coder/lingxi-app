    "settings_cu_forbidden_note": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "禁止控制密码、OTP、生物识别、支付/转账确认、系统授权、设备管理、VPN、安装/卸载和 FLAG_SECURE 窗口。高风险提交、发送、拨号和删除动作每次都需要确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "禁止控制密碼、OTP、生物識別、支付/轉帳確認、系統授權、裝置管理、VPN、安裝/解除安裝和 FLAG_SECURE 視窗。高風險提交、傳送、撥號和刪除動作每次都需要確認。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlling passwords, OTPs, biometrics, payment/transfer confirmations, system permissions, device admin, VPN, install/uninstall, and FLAG_SECURE windows is prohibited. High-risk actions like submit, send, dial, and delete require confirmation every time."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワード、OTP、生体認証、支払い／送金の確認、システム権限、デバイス管理、VPN、インストール／アンインストール、および FLAG_SECURE ウィンドウの操作は禁止されています。高リスクな送信・投稿・発信・削除の操作は毎回確認が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비밀번호, OTP, 생체 인증, 결제/송금 확인, 시스템 권한, 기기 관리, VPN, 설치/제거, FLAG_SECURE 창의 제어는 금지됩니다. 고위험 제출, 전송, 전화 걸기, 삭제 동작은 매번 확인이 필요합니다."
          }
        }
      }
    },
