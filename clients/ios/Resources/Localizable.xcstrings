    "onboarding_assistant_subtitle": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是助手在界面和对话中的称呼，之后可以随时在设置中修改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是助手在介面和對話中的稱呼，之後可以隨時在設定中修改。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is what the assistant will be called in the UI and conversation — you can change it anytime in Settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これはアシスタントが画面や会話の中で使う呼び名です。後から設定でいつでも変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어시스턴트를 화면과 대화에서 부를 이름이며, 나중에 설정에서 언제든 바꿀 수 있습니다."
          }
        }
      }
    },
    "onboarding_assistant_title": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "给你的灵犀起个名字"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "給你的靈犀起個名字"
