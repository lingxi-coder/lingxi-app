    "local_apps_permissions_reset_confirm_detail": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会话授权和持久授权都会清除。下次修改数据、控制界面或访问域名时会重新询问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "會話授權和持久授權都會清除。下次修改資料、控制介面或存取域名時會重新詢問。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both session and persistent authorizations will be cleared. You'll be asked again the next time the app modifies data, controls the UI, or accesses a domain."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セッション権限と永続的な権限の両方がクリアされます。次回データを変更したり、UI を操作したり、ドメインにアクセスする際に再度確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세션 권한과 영구 권한이 모두 지워집니다. 다음에 데이터를 수정하거나 화면을 제어하거나 도메인에 접근할 때 다시 물어봅니다."
          }
        }
      }
    },
