    "dream_compute_budget_footer": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高预算会优先调用更强模型（如 Claude Opus），并访问 MCP 工具。低预算只用本地 + 最便宜模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "高預算會優先呼叫更強模型（如 Claude Opus），並存取 MCP 工具。低預算只用本地 + 最便宜模型。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A higher budget prioritizes stronger models (like Claude Opus) and MCP tool access. A lower budget sticks to local and the cheapest models."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予算を高くすると、より高性能なモデル（Claude Opus など）や MCP ツールを優先的に利用します。予算が低い場合はローカルモデルと最も安価なモデルのみを使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예산이 높을수록 더 강력한 모델(예: Claude Opus)을 우선 사용하고 MCP 도구에 접근합니다. 예산이 낮으면 로컬 모델과 가장 저렴한 모델만 사용합니다."
          }
        }
      }
    },
    "dream_conditions_footer": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确保不会影响日常使用：仅在充电 + Wi-Fi 时跑昂贵任务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確保不會影響日常使用：僅在充電 + Wi-Fi 時跑昂貴任務。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps everyday use unaffected — expensive tasks only run while charging and on Wi-Fi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日常利用の妨げにならないよう、負荷の高いタスクは充電中かつ Wi-Fi 接続時のみ実行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일상 사용에 영향이 없도록: 충전 중 + Wi-Fi 연결 시에만 비용이 큰 작업을 실행합니다."
          }
        }
      }
    },
    "dream_description_blurb": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当设备闲置时，灵犀在后台运行\n整理、规划、润色 — 醒来即可看到结果"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當裝置閒置時，靈犀在背景執行\n整理、規劃、潤色 — 醒來即可看到結果"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While your device is idle, Lingxi works in the background\norganizing, planning, and polishing — see the results when you wake up"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスがアイドル状態のとき、灵犀はバックグラウンドで動作します\n整理・計画・推敲 — 起きたときには結果が届いています"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기가 유휴 상태일 때 灵犀가 백그라운드에서\n정리, 계획, 다듬기를 수행합니다 — 깨어나면 결과를 바로 확인할 수 있습니다"
          }
        }
      }
    },
