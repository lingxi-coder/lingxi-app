    "cron_recovered_timeout_message": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用在上次计划执行中断后恢复，当前已将该次触发标记为超时并确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "應用在上次排定執行中斷後恢復，目前已將該次觸發標記為逾時並確認。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app recovered after the last scheduled run was interrupted; this trigger has been marked as timed out and acknowledged."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリは前回の予定実行が中断された後に復帰しました。今回のトリガーはタイムアウトとしてマークし、確認済みとしました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 예약 실행이 중단된 후 앱이 복구되어, 해당 트리거를 시간 초과로 표시하고 확인 처리했습니다."
          }
        }
      }
