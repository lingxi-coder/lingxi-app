    "settings_cu_audio_footer": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音频只在用户已启动的 Computer Use 会话中可用。听写文本和播报内容不会写入审计记录；临时听写结果也不会进入会话历史。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "音訊只在使用者已啟動的 Computer Use 會話中可用。聽寫文字和播報內容不會寫入審計記錄；臨時聽寫結果也不會進入會話歷史。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio is only available during a Computer Use session you've started. Dictated text and spoken output aren't written to the audit log, and temporary dictation results don't enter the session history."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オーディオは、ユーザーが開始した Computer Use セッション内でのみ利用できます。音声入力のテキストや読み上げ内容は監査記録に書き込まれません。一時的な音声入力結果も会話履歴には残りません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디오는 사용자가 시작한 Computer Use 세션에서만 사용할 수 있습니다. 받아쓴 텍스트와 음성 안내 내용은 감사 기록에 남지 않으며, 임시 받아쓰기 결과도 세션 이력에 포함되지 않습니다."
          }
        }
      }
    },
    "settings_cu_audio_settings": {
      "localizations": {
