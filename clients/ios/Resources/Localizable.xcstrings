    "project_conflict_dialog_body": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认已跳过冲突文件。请选择全部保留本机版本或外部目录版本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設已跳過衝突檔案。請選擇全部保留本機版本或外部目錄版本。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Conflicting files were skipped by default. Choose to keep all local versions or all external versions."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "競合したファイルはデフォルトでスキップされています。すべて端末内バージョンを保持するか、外部ディレクトリバージョンを保持するかを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본적으로 충돌한 파일은 건너뜁니다. 기기 버전 또는 외부 디렉터리 버전 중 하나를 모두 유지하도록 선택해 주세요."
          }
        }
      }
    },
