    "cron_force_stop_notice": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统限制：用户 Force Stop 后，Alarm 和 WorkManager 都会暂停，直到再次打开应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統限制：使用者 Force Stop 後，Alarm 和 WorkManager 都會暫停，直到再次開啟應用。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System limitation: after a user force-stops the app, both Alarm and WorkManager pause until the app is opened again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムの制約：ユーザーが強制停止すると、Alarm と WorkManager はアプリを再度開くまで一時停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 제한: 사용자가 강제 종료하면 다시 앱을 열 때까지 Alarm과 WorkManager가 모두 일시중지됩니다."
          }
        }
      }
    },
