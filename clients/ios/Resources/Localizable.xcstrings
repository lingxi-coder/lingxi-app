    },
    "settings_provider_picker_unavailable_detail": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "联网搜索与网页抓取的真实 Provider 仓储还未在 iOS 侧接通，因此这里只保留空状态，不再提供原型预设卡片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "聯網搜尋與網頁抓取的真實 Provider 倉儲還未在 iOS 側接通，因此這裡只保留空狀態，不再提供原型預設卡片。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Real provider storage for web search and web fetch isn't wired up on iOS yet, so this only shows an empty state rather than prototype preset cards."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウェブ検索とウェブフェッチの実際の Provider ストレージは iOS 側でまだ接続されていないため、ここでは空状態のみを表示し、プロトタイプのプリセットカードは提供していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "웹 검색과 웹 페이지 가져오기의 실제 Provider 저장소는 아직 iOS 쪽에 연결되지 않아, 여기서는 빈 상태만 유지하며 프로토타입 프리셋 카드는 더 이상 제공하지 않습니다."
          }
        }
      }
    },
