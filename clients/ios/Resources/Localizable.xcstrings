    "computeruse_approval_body_fmt": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目标应用：%1$s\n动作：%2$s\n\n此确认只对当前这一次操作有效，60 秒后自动拒绝。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目標應用：%1$s\n動作：%2$s\n\n此確認只對當前這一次操作有效，60 秒後自動拒絕。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Target app: %1$s\nAction: %2$s\n\nThis confirmation applies only to this one action and will auto-deny after 60 seconds."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対象アプリ：%1$s\n操作：%2$s\n\nこの確認は今回の操作にのみ有効です。60 秒後に自動的に拒否されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대상 앱: %1$s\n동작: %2$s\n\n이 확인은 이번 한 번의 작업에만 유효하며, 60초 후 자동으로 거부됩니다."
          }
        }
      }
    },
