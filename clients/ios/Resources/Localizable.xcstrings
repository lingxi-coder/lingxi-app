    "chat_compaction %u %u %llu": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上下文压缩：%u → %u，释放 %llu B"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上下文壓縮：%u → %u，釋放 %llu B"
          }
        },
