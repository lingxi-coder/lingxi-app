    "cron_ios_scheduling_note": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 只提供“最早不早于”的系统调度，不保证准点启动；也可随时立即运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 只提供「最早不早於」的系統排程，不保證準點啟動；也可隨時立即執行。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS only offers “no earlier than” system scheduling — exact start times aren't guaranteed, but you can always run it immediately."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS が提供するのは「これより早くは実行しない」というシステムスケジュールのみで、定刻での起動は保証されません。いつでも今すぐ実行することもできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS는 \"이 시각보다 이르지 않게\"라는 시스템 예약만 제공하며, 정시 시작을 보장하지 않습니다. 언제든 즉시 실행할 수도 있습니다."
          }
        }
      }
    },
