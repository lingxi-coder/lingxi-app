    "settings_linux_saf_picker_summary": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将通过系统目录选择器（SAF）逐目录授权，不暴露任意宿主路径"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將透過系統目錄選擇器（SAF）逐目錄授權，不暴露任意宿主路徑"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Authorized directory by directory through the system folder picker (SAF) — never exposes arbitrary host paths"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムのディレクトリ選択（SAF）を通じてディレクトリ単位で許可します。任意のホストパスが公開されることはありません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 디렉터리 선택기(SAF)를 통해 디렉터리별로 권한을 부여하며, 임의의 호스트 경로는 노출되지 않습니다"
          }
        }
