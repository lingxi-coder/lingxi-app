    "settings_linux_blurb": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "真机内置 iSH ARM64 与 Alpine Linux，可运行 shell、Python、包管理器和项目文件；Simulator 继续使用明确的 unavailable stub。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "真機內建 iSH ARM64 與 Alpine Linux，可執行 shell、Python、包管理器和專案檔案；Simulator 繼續使用明確的 unavailable stub。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Real devices include iSH ARM64 and Alpine Linux, letting you run a shell, Python, package managers, and project files; the Simulator keeps returning an explicit unavailable stub."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実機には iSH ARM64 と Alpine Linux が組み込まれており、shell・Python・パッケージマネージャー・プロジェクトファイルを実行できます。シミュレーターでは引き続き明示的な unavailable スタブを使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실기기에는 iSH ARM64와 Alpine Linux가 내장되어 있어 셸, Python, 패키지 관리자와 프로젝트 파일을 실행할 수 있습니다. 시뮬레이터는 계속해서 명시적인 unavailable stub을 사용합니다."
          }
        }
      }
    },
    "settings_linux_blurb_android": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mobile Linux 使用受管 Alpine rootfs 与 Android PRoot 后端。选择该模式后，运行时错误会直接显示，不会静默回退到 Legacy。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Mobile Linux 使用受管 Alpine rootfs 與 Android PRoot 後端。選擇該模式後，執行時錯誤會直接顯示，不會靜默回退到 Legacy。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mobile Linux uses a managed Alpine rootfs with an Android PRoot backend. Once selected, runtime errors are shown directly instead of silently falling back to Legacy."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mobile Linux は管理された Alpine rootfs と Android PRoot バックエンドを使用します。このモードを選択すると、ランタイムエラーはそのまま表示され、Legacy へ黙って切り替わることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mobile Linux는 관리형 Alpine rootfs와 Android PRoot 백엔드를 사용합니다. 이 모드를 선택하면 런타임 오류가 그대로 표시되며, Legacy로 조용히 대체되지 않습니다."
          }
        }
      }
    },
