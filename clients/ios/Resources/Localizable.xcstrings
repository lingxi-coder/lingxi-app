    "settings_memory_blurb": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "灵犀根据对话自动提取关于你的偏好、习惯、关系。你可以随时编辑或删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "靈犀根據對話自動提取關於你的偏好、習慣、關係。你可以隨時編輯或刪除。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingxi automatically picks up on your preferences, habits, and relationships from your conversations. You can edit or delete any of it anytime."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "灵犀は会話から、あなたの好みや習慣、人間関係を自動的に抽出します。いつでも編集・削除できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "灵犀는 대화를 바탕으로 당신의 선호, 습관, 관계를 자동으로 추출합니다. 언제든지 편집하거나 삭제할 수 있습니다."
          }
        }
      }
    },
