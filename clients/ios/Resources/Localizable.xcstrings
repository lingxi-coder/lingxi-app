    "mcp_tool_permissions_footer": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "灵犀只会调用你允许的工具。每次首次调用会请求确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "靈犀只會呼叫你允許的工具。每次首次呼叫會請求確認。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingxi only calls the tools you allow. You'll be asked to confirm the first time each one is used."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "灵犀は許可したツールのみを呼び出します。初回呼び出し時には必ず確認を求めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "灵犀는 허용한 도구만 호출합니다. 처음 호출할 때마다 확인을 요청합니다."
          }
        }
      }
    },
