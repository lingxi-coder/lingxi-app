          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統將自動選擇識別方式；當前語言通常會使用線上識別"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The system will automatically choose a recognition method; the current language usually uses online recognition"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムが自動的に認識方式を選択します。現在の言語では通常オンライン認識が使用されます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
