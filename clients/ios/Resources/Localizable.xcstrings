    "cron_exact_alarm_banner_body": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未授予“闹钟和提醒”权限。任务仍会创建，但由 WorkManager 每 15 分钟巡检，触发时间可能延迟。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未授予「鬧鐘和提醒」權限。任務仍會建立，但由 WorkManager 每 15 分鐘巡檢，觸發時間可能延遲。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“Alarms & reminders” permission wasn't granted. Tasks are still created, but WorkManager checks every 15 minutes, so trigger times may be delayed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「アラームとリマインダー」の権限が許可されていません。タスクは作成されますが、WorkManager が 15 分ごとに巡回チェックするため、トリガーが遅れる可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"알람 및 리마인더\" 권한이 부여되지 않았습니다. 작업은 계속 생성되지만 WorkManager가 15분마다 점검하며, 실행 시각이 늦어질 수 있습니다."
          }
        }
      }
    },
