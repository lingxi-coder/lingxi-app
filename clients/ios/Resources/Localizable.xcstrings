    "local_apps_delete_confirm_detail": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代码、构建产物、日志和本地 SQLite 数据都会永久删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
