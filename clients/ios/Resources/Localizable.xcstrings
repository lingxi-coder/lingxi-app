    "onboarding_voiceprint_subtitle": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让灵犀听声识人，只对你的声音响应、唤起属于你的记忆。可稍后在设置里完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓靈犀聽聲識人，只對你的聲音響應、喚起屬於你的記憶。可稍後在設定裡完成。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let Lingxi recognize you by voice, responding only to your voice and recalling memories that belong to you. You can finish this later in Settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "灵犀があなたの声を覚え、あなたの声にのみ反応してあなた専用の記憶を呼び起こします。後で設定から完了することもできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "灵犀가 목소리로 당신을 알아보게 하세요. 당신의 목소리에만 반응하고 당신만의 기억을 불러옵니다. 나중에 설정에서 완료할 수도 있습니다."
          }
        }
      }
    },
    "onboarding_voiceprint_title": {
      "localizations": {
        "zh-Hans": {
