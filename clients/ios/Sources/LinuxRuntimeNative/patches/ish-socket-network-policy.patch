diff --git a/fs/sock.c b/fs/sock.c
index 788bbf77..ecde9dac 100644
--- a/fs/sock.c
+++ b/fs/sock.c
@@ -17,0 +18,45 @@
+enum {
+    LXISH_NETWORK_ALLOWED = 0,
+    LXISH_NETWORK_DISABLED = 1,
+    LXISH_NETWORK_LOOPBACK_ONLY = 2,
+};
+
+extern int lx_ish_network_policy_for_context(uint64_t context);
+
+uint32_t lx_ish_sock_policy_hook_version(void) {
+    return 1;
+}
+
+static int lingxi_network_policy(void) {
+    if (current == NULL || current->group == NULL)
+        return LXISH_NETWORK_ALLOWED;
+    return lx_ish_network_policy_for_context(current->group->fs_context);
+}
+
+static int lingxi_validate_socket_domain(dword_t domain) {
+    int policy = lingxi_network_policy();
+    if (policy == LXISH_NETWORK_ALLOWED || domain == AF_LOCAL_)
+        return 0;
+    if (policy == LXISH_NETWORK_LOOPBACK_ONLY &&
+            (domain == AF_INET_ || domain == AF_INET6_))
+        return 0;
+    return _EPERM;
+}
+
+static int lingxi_validate_sockaddr(const struct sockaddr *address) {
+    int policy = lingxi_network_policy();
+    if (policy == LXISH_NETWORK_ALLOWED || address->sa_family == PF_LOCAL)
+        return 0;
+    if (policy == LXISH_NETWORK_DISABLED)
+        return _EPERM;
+    if (address->sa_family == PF_INET) {
+        const struct sockaddr_in *ipv4 = (const struct sockaddr_in *)address;
+        return (ntohl(ipv4->sin_addr.s_addr) >> 24) == 127 ? 0 : _EPERM;
+    }
+    if (address->sa_family == PF_INET6) {
+        const struct sockaddr_in6 *ipv6 = (const struct sockaddr_in6 *)address;
+        return IN6_IS_ADDR_LOOPBACK(&ipv6->sin6_addr) ? 0 : _EPERM;
+    }
+    return _EPERM;
+}
+
@@ -39,0 +85,3 @@ int_t sys_socket(dword_t domain, dword_t type, dword_t protocol) {
+    int policy_error = lingxi_validate_socket_domain(domain);
+    if (policy_error < 0)
+        return policy_error;
@@ -340,0 +389,3 @@ int_t sys_bind(fd_t sock_fd, addr_t sockaddr_addr, uint_t sockaddr_len) {
+    if (err < 0)
+        return err;
+    err = lingxi_validate_sockaddr((const struct sockaddr *)&sockaddr);
@@ -380,0 +432,3 @@ int_t sys_connect(fd_t sock_fd, addr_t sockaddr_addr, uint_t sockaddr_len) {
+    if (err < 0)
+        return err;
+    err = lingxi_validate_sockaddr((const struct sockaddr *)&sockaddr);
@@ -571,0 +626,3 @@ int_t sys_socketpair(dword_t domain, dword_t type, dword_t protocol, addr_t sock
+    int policy_error = lingxi_validate_socket_domain(domain);
+    if (policy_error < 0)
+        return policy_error;
@@ -636,0 +694,3 @@ int_t sys_sendto(fd_t sock_fd, addr_t buffer_addr, dword_t len, dword_t flags, a
+        err = lingxi_validate_sockaddr((const struct sockaddr *)&sockaddr);
+        if (err < 0)
+            goto error;
@@ -1030,0 +1091,3 @@ int_t sys_sendmsg(fd_t sock_fd, addr_t msghdr_addr, int_t flags) {
+        if (err < 0)
+            return err;
+        err = lingxi_validate_sockaddr((const struct sockaddr *)&msg_name);
