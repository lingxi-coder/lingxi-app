diff --git a/kernel/resource.c b/kernel/resource.c
index 618929d7..2e07ca06 100644
--- a/kernel/resource.c
+++ b/kernel/resource.c
@@ -12,0 +13 @@
+#include <stdlib.h>
@@ -290,0 +292,91 @@ int_t sys_ioprio_set(int_t UNUSED(which), int_t UNUSED(who), int_t UNUSED(ioprio
+
+// Host-side watchdog hooks for a single opaque execution context. These live
+// inside libish so they are compiled with the same guest architecture and can
+// safely pin address spaces while guest exec/fork activity continues.
+uint64_t lx_ish_guest_execution_resident_bytes(uint64_t context) {
+    struct mm **address_spaces = calloc((size_t) MAX_PID + 1, sizeof(*address_spaces));
+    struct task **locked_tasks = calloc((size_t) MAX_PID + 1, sizeof(*locked_tasks));
+    size_t address_space_count = 0;
+    size_t locked_task_count = 0;
+    uint64_t bytes = 0;
+
+    if (context == 0)
+        return 0;
+    // Fail closed: the host interprets UINT64_MAX as over every finite limit.
+    if (address_spaces == NULL || locked_tasks == NULL) {
+        free(address_spaces);
+        free(locked_tasks);
+        return UINT64_MAX;
+    }
+
+    // Pin every matching task's mm pointer under general_lock. Holding all of
+    // those locks until the scan finishes prevents exec/exit from replacing
+    // or releasing an address space without touching iSH's non-atomic mm
+    // refcount. Threads share an mm; forked processes do not and are summed
+    // like process-group RSS.
+    lock(&pids_lock);
+    for (int pid = 2; pid <= MAX_PID; pid++) {
+        struct task *task = pid_get_task((dword_t) pid);
+        struct mm *task_mm;
+        bool seen = false;
+
+        if (task == NULL || task->group == NULL || task->exiting ||
+                task->group->fs_context != context)
+            continue;
+        lock(&task->general_lock);
+        if (task->group == NULL || task->exiting ||
+                task->group->fs_context != context || task->mm == NULL) {
+            unlock(&task->general_lock);
+            continue;
+        }
+        locked_tasks[locked_task_count++] = task;
+        task_mm = task->mm;
+        for (size_t index = 0; index < address_space_count; index++) {
+            if (address_spaces[index] == task_mm) {
+                seen = true;
+                break;
+            }
+        }
+        if (!seen && address_space_count <= MAX_PID) {
+            address_spaces[address_space_count++] = task_mm;
+        }
+    }
+    unlock(&pids_lock);
+
+    for (size_t index = 0; index < address_space_count; index++) {
+        struct mem *memory = &address_spaces[index]->mem;
+        read_wrlock(&memory->lock);
+        for (page_t page = 0; page < MEM_PAGES; mem_next_page(memory, &page)) {
+            if (mem_pt(memory, page) != NULL) {
+                if (UINT64_MAX - bytes < PAGE_SIZE) {
+                    bytes = UINT64_MAX;
+                    break;
+                }
+                bytes += PAGE_SIZE;
+            }
+        }
+        read_wrunlock(&memory->lock);
+    }
+    for (size_t index = locked_task_count; index > 0; index--)
+        unlock(&locked_tasks[index - 1]->general_lock);
+    free(locked_tasks);
+    free(address_spaces);
+    return bytes;
+}
+
+int lx_ish_guest_execution_context_active(uint64_t context) {
+    int active = 0;
+    if (context == 0)
+        return 0;
+    lock(&pids_lock);
+    for (int pid = 2; pid <= MAX_PID; pid++) {
+        struct task *task = pid_get_task((dword_t) pid);
+        if (task != NULL && task->group != NULL &&
+                task->group->fs_context == context) {
+            active = 1;
+            break;
+        }
+    }
+    unlock(&pids_lock);
+    return active;
+}
