{
  "schema_version": 1,
  "node_executable": "/usr/bin/node",
  "vite_executable": "/opt/lingxi/local-app-runtime/node_modules/vite/bin/vite.js",
  "node_modules_mount": {
    "source": "bundled:local-app-runtime/node_modules",
    "target": "/opt/lingxi/local-app-runtime/node_modules",
    "read_only": true
  },
  "scaffold": {
    "primary": "official_create_vite_cli",
    "target": "empty_staging_source_root",
    "javascript_command": "npm create vite@latest . -- --template react --no-interactive",
    "typescript_command": "npm create vite@latest . -- --template react-ts --no-interactive",
    "shell": "existing_mobile_linux_shell",
    "offline_fallback": ".lingxi/vite-fallback",
    "fallback_only_when": "registry_or_network_unavailable"
  },
  "commands": {
    "vite_static_build": {
      "argv": [
        "/usr/bin/node",
        "--max-old-space-size={build_node_old_space_size_mib}",
        "/opt/lingxi/local-app-runtime/node_modules/vite/bin/vite.js",
        "build"
      ],
      "environment": {
        "NODE_ENV": "production",
        "NODE_PATH": "/opt/lingxi/local-app-runtime/node_modules"
      },
      "network_policy": "disabled",
      "memory_limit_policy": "physical_memory_tier",
      "timeout_ms": 1800000
    }
  },
  "limits": {
    "build_concurrency": 1,
    "build_node_old_space_percent": 75,
    "build_memory_tiers": [
      {
        "physical_memory_max_exclusive_bytes": 6442450944,
        "process_tree_memory_bytes": 2147483648,
        "node_max_old_space_size_mib": 1536
      },
      {
        "physical_memory_max_exclusive_bytes": 8589934592,
        "process_tree_memory_bytes": 3221225472,
        "node_max_old_space_size_mib": 2304
      },
      {
        "physical_memory_max_exclusive_bytes": null,
        "process_tree_memory_bytes": 4294967296,
        "node_max_old_space_size_mib": 3072
      }
    ],
    "runtime_process_tree_memory_bytes": 838860800,
    "max_page_size": 100,
    "max_batch_mutations": 50
  },
  "android_network_policy_launcher": {
    "source": "clients/android/app/src/main/cpp/mobile_linux_policy_launcher.c",
    "source_sha256": "3cf616ba8f5d94c5026eeb0dbc5d60cfe92e333f2d470e665d0e43752e895026",
    "proot_overlay_source": "clients/android/app/src/main/cpp/proot_lingxi_network_policy.c",
    "proot_overlay_source_sha256": "752a7fc0a0b2cd5fcdfca0f8fa094d274c32430f4acfc891e6680c3764610e26",
    "artifact": "libmobile_linux_policy_launcher.so",
    "supported_network_policies": [
      "disabled",
      "loopback_only"
    ],
    "loopback_only_ready": true,
    "abis": [
      "arm64-v8a",
      "x86_64"
    ],
    "variants": [
      "play",
      "direct"
    ]
  },
  "ios_ish_execution_policy": {
    "registry_source": "clients/ios/Sources/LinuxRuntimeNative/LXISHExecutionPolicy.c",
    "registry_source_sha256": "599492ddae2141b0e899b749c44b4c9f946c299e260d79bf9ae182a66c6661c8",
    "header_source": "clients/ios/Sources/LinuxRuntimeNative/LXISHExecutionPolicy.h",
    "header_source_sha256": "c92b7af0f20412c8a8622fe408c757637df9ca98f7e2930d6e80660670fa91dc",
    "ish_patch_source": "clients/ios/Sources/LinuxRuntimeNative/patches/ish-socket-network-policy.patch",
    "ish_patch_source_sha256": "f4ea9b396b7dfd4f9f9d15507fc680ccc40a596be85042792f442eac85d21c79",
    "hook_version": 1,
    "supported_network_policies": [
      "disabled",
      "loopback_only"
    ],
    "loopback_only_ready": true,
    "runtime_memory_limit_bytes": 838860800,
    "watchdog_interval_ms": 250,
    "memory_accounting": "guest_backed_pages_by_execution_context",
    "platform": "iphoneos"
  },
  "package_manager_policy": {
    "interactive_terminal_apk": true,
    "generation_jobs": false,
    "mcp": false,
    "npm_family_present": true,
    "npm_scope": "app_workspace_shell_approval"
  }
