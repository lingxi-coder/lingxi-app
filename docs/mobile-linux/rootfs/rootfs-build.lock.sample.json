{
  "schema_version": 1,
  "alpine": {
    "version": "3.21.3",
    "branch": "v3.21",
    "repositories": [
      "https://dl-cdn.alpinelinux.org/alpine/v3.21/main",
      "https://dl-cdn.alpinelinux.org/alpine/v3.21/community"
    ]
  },
  "policy": {
    "archive_format": "tar.gz",
    "busybox_applet_strategy": "hardlink",
    "apk_disabled": false,
    "interactive_package_install_allowed": true,
    "forbidden_package_manager_paths": [
      "/usr/bin/pip",
      "/usr/bin/pip3",
      "/usr/bin/npm",
      "/usr/bin/npx"
    ],
    "fixed_primary_packages": [
      "apk-tools",
      "busybox",
      "git",
      "openssh-client",
      "python3",
      "ca-certificates"
    ]
  },
  "resolved_packages": [
    {
      "name": "apk-tools",
      "version": "REPLACE_WITH_REAL_VERSION",
      "license": "REPLACE_WITH_REAL_LICENSE",
      "architecture": "arm64",
      "origin": "apk-tools"
    },
    {
      "name": "busybox",
      "version": "REPLACE_WITH_REAL_VERSION",
      "license": "REPLACE_WITH_REAL_LICENSE",
      "architecture": "arm64",
      "origin": "busybox"
    },
    {
      "name": "git",
      "version": "REPLACE_WITH_REAL_VERSION",
      "license": "REPLACE_WITH_REAL_LICENSE",
      "architecture": "arm64",
      "origin": "git"
    },
    {
      "name": "openssh-client",
      "version": "REPLACE_WITH_REAL_VERSION",
      "license": "REPLACE_WITH_REAL_LICENSE",
      "architecture": "arm64",
      "origin": "openssh"
    },
    {
      "name": "python3",
      "version": "REPLACE_WITH_REAL_VERSION",
      "license": "REPLACE_WITH_REAL_LICENSE",
      "architecture": "arm64",
      "origin": "python3"
    },
    {
      "name": "ca-certificates",
      "version": "REPLACE_WITH_REAL_VERSION",
      "license": "REPLACE_WITH_REAL_LICENSE",
      "architecture": "arm64",
      "origin": "ca-certificates"
    }
  ]
}
