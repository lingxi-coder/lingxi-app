{
  "functions": [
    {
      "source": "apps/firebase",
      "codebase": "backend",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        "test",
        ".git",
        "*-debug.log"
      ]
    }
  ],
  "firestore": [
    {
      "database": "(default)",
      "rules": "infra/firebase/firestore.rules",
      "indexes": "infra/firebase/firestore.indexes.json"
    },
    {
      "database": "model-catalog",
      "location": "us-central1",
      "rules": "infra/firebase/firestore.rules",
      "indexes": "infra/firebase/firestore.indexes.json"
    },
    {
      "database": "push-notifications",
      "location": "us-central1",
      "rules": "infra/firebase/firestore.rules",
      "indexes": "infra/firebase/push.indexes.json"
    }
  ],
  "storage": {
    "rules": "infra/firebase/storage.rules"
  },
  "database": {
    "rules": "infra/firebase/database.rules.json"
  },
  "auth": {
    "providers": {
      "emailPassword": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "LingXi",
        "supportEmail": "luolingfeng.lingxi@gmail.com"
      }
    }
  },
  "hosting": {
    "site": "lingxi-5e4b2",
    "public": "apps/web/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ]
      },
      {
        "source": "/admin/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/v1/**",
        "function": {
          "functionId": "catalogApi",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
