rules_version = '2';
// Only (default) uses these rules. Other databases retain firestore.rules (deny-all).
// Conversation membership is generated by the trusted backend, never by a client.
// Every message creation/edit/recall atomically writes a message, an immutable
// changes/{changeId} receipt and the conversation's change cursor. See docs/TEAMS.md.
service cloud.firestore {
  match /databases/{database}/documents {
    function teamPath(tid) { return /databases/$(database)/documents/teams/$(tid); }
    function memberPath(tid, uid) { return /databases/$(database)/documents/teams/$(tid)/members/$(uid); }
    function botPath(tid, key) { return /databases/$(database)/documents/teams/$(tid)/bots/$(key); }
    function convPath(tid, cid) { return /databases/$(database)/documents/teams/$(tid)/conversations/$(cid); }
    function msgPath(tid, cid, mid) { return /databases/$(database)/documents/teams/$(tid)/conversations/$(cid)/messages/$(mid); }
    function changePath(tid, cid, id) { return /databases/$(database)/documents/teams/$(tid)/conversations/$(cid)/changes/$(id); }

    function isSelf(uid) { return database == '(default)' && request.auth != null && request.auth.uid == uid; }
    function isMember(tid) {
      return database == '(default)' && request.auth != null && get(teamPath(tid)).data.state == 'active'
        && exists(memberPath(tid, request.auth.uid));
    }
    function inConversation(tid, cid) {
      return isMember(tid) && request.auth.uid in get(convPath(tid, cid)).data.memberUids;
    }
    function mayUseBot(tid, key) {
      let b = get(botPath(tid, key)).data;
      return b.enabled == true && b.ownerGeneration == get(memberPath(tid, b.ownerUid)).data.generation
        && (b.ownerUid == request.auth.uid || b.use == 'all'
        || (b.use == 'listed' && request.auth.uid in b.get('uids', [])));
    }
    function maySpeak(tid, cid) {
      let c = get(convPath(tid, cid)).data;
      return inConversation(tid, cid) && (c.kind != 'bot_dm' || mayUseBot(tid, c.botKey));
    }
    function validText(text) { return text is string && text.size() > 0 && text.toUtf8().size() <= 8192; }
    function validId(id) { return id is string && id.matches('^[A-Za-z0-9_-]{8,64}$'); }
    function isAuthor(tid, cid, a) {
      return a.uid == request.auth.uid && (
        (a.kind == 'user' && a.keys().hasOnly(['kind', 'uid']))
        || (a.kind == 'bot' && a.keys().hasOnly(['kind', 'uid', 'botKey']) && a.botKey is string
          && a.botKey in get(convPath(tid, cid)).data.participants
          && get(botPath(tid, a.botKey)).data.ownerUid == request.auth.uid
          && get(botPath(tid, a.botKey)).data.enabled == true
          && get(botPath(tid, a.botKey)).data.ownerGeneration == get(memberPath(tid, request.auth.uid)).data.generation));
    }

    // Cross-check the immutable receipt and both sides of the conversation cursor.
    function hasChange(tid, cid, mid, m, operation) {
      let c = get(convPath(tid, cid)).data;
      let after = getAfter(convPath(tid, cid)).data;
      let change = getAfter(changePath(tid, cid, m.changeId)).data;
      return validId(m.changeId) && m.changeSeq is int && m.changeSeq == c.lastChangeSeq + 1
        && after.lastChangeSeq == m.changeSeq && after.lastChange.id == m.changeId
        && change.seq == m.changeSeq && change.messageId == mid && change.operation == operation
        && change.actorUid == request.auth.uid && change.generation == get(memberPath(tid, request.auth.uid)).data.generation && change.at == request.time;
    }
    function isNewMessage(tid, cid, mid) {
      let m = request.resource.data;
      return m.keys().hasOnly(['seq', 'author', 'kind', 'text', 'mentions', 'replyTo', 'createdAt', 'changeSeq', 'changeId'])
        && m.keys().hasAll(['seq', 'author', 'kind', 'text', 'createdAt', 'changeSeq', 'changeId'])
        && validId(mid) && !mid.matches('^bot_.*$') && m.seq is int && m.seq == get(convPath(tid, cid)).data.lastSeq + 1
        && getAfter(convPath(tid, cid)).data.lastSeq == m.seq
        && getAfter(convPath(tid, cid)).data.lastMessage.id == mid
        && m.createdAt == request.time && m.kind in ['text', 'status', 'question', 'task_ref', 'app_ref']
        && validText(m.text)
        // Mentions are display metadata, not executable Bot requests (T3 uses authenticated triggers).
        && (!('mentions' in m) || (m.mentions is list && m.mentions.size() <= 32))
        && (!('replyTo' in m) || m.replyTo is string)
        && isAuthor(tid, cid, m.author) && hasChange(tid, cid, mid, m, 'create');
    }
    function isEdit(tid, cid, mid) {
      let m = request.resource.data;
      return resource.data.get('recalled', false) == false
        && m.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt', 'changeSeq', 'changeId'])
        && validText(m.text) && m.editedAt == request.time && hasChange(tid, cid, mid, m, 'edit');
    }
    function isRecall(tid, cid, mid) {
      let m = request.resource.data;
      return resource.data.get('recalled', false) == false
        && m.diff(resource.data).affectedKeys().hasOnly(['recalled', 'text', 'editedAt', 'changeSeq', 'changeId'])
        && m.recalled == true && m.text == '' && m.editedAt == request.time
        && hasChange(tid, cid, mid, m, 'recall');
    }
    function isConversationChange(tid, cid) {
      let before = resource.data;
      let after = request.resource.data;
      let change = getAfter(changePath(tid, cid, after.lastChange.id)).data;
      return after.diff(before).affectedKeys().hasOnly(['lastSeq', 'lastMessage', 'lastChangeSeq', 'lastChange'])
        && after.lastChangeSeq is int && after.lastChangeSeq == before.lastChangeSeq + 1
        && after.lastChange.keys().hasOnly(['id', 'seq']) && validId(after.lastChange.id)
        && after.lastChange.seq == after.lastChangeSeq && change.seq == after.lastChangeSeq
        && !exists(changePath(tid, cid, after.lastChange.id))
        && ((change.operation == 'create'
          && after.lastSeq is int && after.lastSeq == before.lastSeq + 1
          && after.lastMessage.keys().hasOnly(['id', 'seq', 'at'])
          && after.lastMessage.id == change.messageId && after.lastMessage.seq == after.lastSeq
          && after.lastMessage.at == request.time)
          || (change.operation in ['edit', 'recall'] && after.lastSeq == before.lastSeq
            && after.lastMessage == before.lastMessage));
    }
    function isNewChange(tid, cid, id) {
      let e = request.resource.data;
      let m = getAfter(msgPath(tid, cid, e.messageId)).data;
      return e.keys().hasOnly(['seq', 'messageId', 'operation', 'actorUid', 'generation', 'at', 'textDigest'])
        && e.keys().hasAll(['seq', 'messageId', 'operation', 'actorUid', 'generation', 'at', 'textDigest'])
        && validId(id) && !id.matches('^bot_.*$') && validId(e.messageId) && !e.messageId.matches('^bot_.*$') && e.seq is int
        && e.seq == get(convPath(tid, cid)).data.lastChangeSeq + 1
        && getAfter(convPath(tid, cid)).data.lastChangeSeq == e.seq
        && getAfter(convPath(tid, cid)).data.lastChange.id == id
        && e.actorUid == request.auth.uid && e.generation == get(memberPath(tid, request.auth.uid)).data.generation && e.at == request.time
        && e.textDigest == hashing.sha256(m.text.toUtf8()).toHexString().lower()
        && m.changeSeq == e.seq && m.changeId == id
        && ((e.operation == 'create' && !exists(msgPath(tid, cid, e.messageId)))
          || (e.operation in ['edit', 'recall'] && exists(msgPath(tid, cid, e.messageId))
            && get(msgPath(tid, cid, e.messageId)).data.changeSeq < e.seq && m.editedAt == request.time));
    }
    function isReadMark(tid, cid) {
      let r = request.resource.data;
      return r.keys().hasOnly(['lastReadSeq', 'generation']) && r.generation == get(memberPath(tid, request.auth.uid)).data.generation && r.lastReadSeq is int && r.lastReadSeq >= 0
        && r.lastReadSeq <= getAfter(convPath(tid, cid)).data.lastSeq;
    }

    match /users/{uid}/teams/{tid} { allow get, list: if isSelf(uid); }
    match /teams/{tid} {
      allow get: if isMember(tid);
      match /members/{uid} {
        allow get, list: if isMember(tid);
        allow update: if isSelf(uid) && isMember(tid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastActiveAt'])
          && request.resource.data.lastActiveAt == request.time;
      }
      // Trusted writes contain only a timestamp and an opaque card identity.
      match /signals/{key} { allow get, list: if isMember(tid); }
      match /bots/{key} {
        // The authenticated API filters inactive/tombstoned cards for their
        // owner. Direct reads would bypass that visibility boundary. Rules'
        // internal get/getAfter checks still validate message Bot ACLs.
        allow get, list: if false;
        // Binding revisions and owner generations are trusted API writes. In
        // particular, an SDK write cannot resurrect an old binding/trigger.
      }
      match /conversations/{cid} {
        // Create/participant mutation go through teamsApi, which derives memberUids
        // from authenticated participants and includes every Bot's owner.
        allow get, list: if isMember(tid) && request.auth.uid in resource.data.memberUids;
        allow update: if maySpeak(tid, cid) && isConversationChange(tid, cid);
        match /messages/{mid} {
          allow get, list: if inConversation(tid, cid);
          allow create: if maySpeak(tid, cid) && isNewMessage(tid, cid, mid);
          allow update: if maySpeak(tid, cid) && request.auth.uid == resource.data.author.uid
            && (isEdit(tid, cid, mid) || isRecall(tid, cid, mid));
        }
        match /changes/{id} {
          allow get, list: if inConversation(tid, cid);
          allow create: if maySpeak(tid, cid) && isNewChange(tid, cid, id);
        }
        match /reads/{uid} {
          allow get: if isSelf(uid) && inConversation(tid, cid);
          allow create: if isSelf(uid) && inConversation(tid, cid) && isReadMark(tid, cid);
          allow update: if isSelf(uid) && inConversation(tid, cid) && isReadMark(tid, cid)
            && (resource.data.generation != request.resource.data.generation || request.resource.data.lastReadSeq >= resource.data.lastReadSeq);
        }
      }
    }
  }
}
