{
  "schema_version": 1,
  "agent_writable_roots": [
    "app",
    "components",
    "lib",
    "styles",
    "public"
  ],
  "host_managed_paths": [
    ".lingxi",
    "next.config.mjs",
    "package.json",
    "package-lock.json",
    "node_modules"
  ],
  "forbidden_path_segments": [
    ".."
  ],
  "forbidden_features": [
    "api_routes",
    "arbitrary_javascript_bridge_actions",
    "direct_network_calls",
    "eval",
    "external_scripts",
    "package_install",
    "server_actions",
    "symbolic_links"
  ]
}
