{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lingxi.local/local-app/design-spec.schema.json",
  "title": "Local App design spec",
  "description": "Closed designer-owned design subtree. Confirmed product, targets and acceptance requirements are not present.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "design": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "presentations": { "$ref": "#/$defs/presentations" },
        "tokens": { "$ref": "#/$defs/tokens" },
        "states": { "$ref": "#/$defs/states" },
        "inputs": { "$ref": "#/$defs/inputs" },
        "canvas": { "$ref": "#/$defs/canvas" }
      },
      "required": ["presentations", "tokens", "states", "inputs"]
    }
  },
  "required": ["design"],
  "$defs": {
    "string": { "type": "string", "minLength": 1, "maxLength": 16384 },
    "strings": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/string" } },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "structure": { "$ref": "#/$defs/strings" },
        "theme": { "$ref": "#/$defs/theme" },
        "style": { "$ref": "#/$defs/style" },
        "references": { "$ref": "#/$defs/strings" }
      },
      "required": ["structure", "theme", "style", "references"]
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "mode": { "$ref": "#/$defs/string" }, "accent": { "$ref": "#/$defs/string" } },
      "required": ["mode", "accent"]
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "direction": { "$ref": "#/$defs/string" }, "density": { "$ref": "#/$defs/string" } },
      "required": ["direction", "density"]
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target_id": { "$ref": "#/$defs/string" },
        "presentation": { "$ref": "#/$defs/string" },
        "navigation": { "$ref": "#/$defs/string" }
      },
      "required": ["target_id", "presentation", "navigation"]
    },
    "presentations": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "$ref": "#/$defs/presentation" } },
    "tokens": {
      "type": "object",
      "maxProperties": 128,
      "additionalProperties": { "$ref": "#/$defs/string" },
      "propertyNames": { "minLength": 1, "maxLength": 16384 }
    },
    "states": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "loading": { "$ref": "#/$defs/string" },
        "empty": { "$ref": "#/$defs/string" },
        "error": { "$ref": "#/$defs/string" },
        "success": { "$ref": "#/$defs/string" },
        "permission": { "$ref": "#/$defs/string" }
      },
      "required": ["loading", "empty", "error", "success", "permission"]
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pointer_touch": { "$ref": "#/$defs/strings" },
        "keyboard_mouse": { "$ref": "#/$defs/strings" },
        "back": { "$ref": "#/$defs/string" },
        "reduced_motion": { "$ref": "#/$defs/string" }
      },
      "required": ["pointer_touch", "keyboard_mouse", "back", "reduced_motion"]
    },
    "canvas": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "scene": { "$ref": "#/$defs/string" },
        "phases": { "allOf": [{ "$ref": "#/$defs/strings" }, { "minItems": 1 }] },
        "controls": { "allOf": [{ "$ref": "#/$defs/strings" }, { "minItems": 1 }] },
        "hud": { "$ref": "#/$defs/string" }
      },
      "required": ["scene", "phases", "controls", "hud"]
    }
  }
}
