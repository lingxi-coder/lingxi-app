@JvmInline
value class AudioSource(val value: String) {
    companion object {
        val AUTOMATIC = AudioSource("automatic")
        val SYSTEM = AudioSource("system")
        val PROVIDER = AudioSource("provider")
        val OFFLINE = AudioSource("offline")
